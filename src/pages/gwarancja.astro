---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentSection from '../components/ContentSection.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';

const terms = [
  {
    title: 'Gwarancja na usługi',
    items: [
      '24 miesiące gwarancji na wykonane naprawy klimatyzacji',
      'Gwarancja obejmuje poprawność wykonania usługi',
      'W przypadku reklamacji prosimy o kontakt telefoniczny',
    ],
  },
  {
    title: 'Gwarancja na części',
    items: [
      'Części nowe — 24 miesiące gwarancji',
      'Części regenerowane — 24 miesiące gwarancji',
      'Producenci części często dają tylko 12 miesięcy — u nas zawsze 24 miesiące',
    ],
  },
  {
    title: 'Warunki gwarancji',
    items: [
      'Gwarancja dotyczy wyłącznie części zregenerowanych lub wymienionych',
      'Klient gwarancyjny obsługiwany jest poza kolejnością, bez oczekiwania',
      'Gwarancja dotyczy tylko części zakupionych i zamontowanych w naszej firmie',
    ],
  },
];

const details = [
  {
    question: 'Okres gwarancji',
    answer: ['Jeżeli w ciągu 24 miesięcy od regeneracji lub wymiany zawiedzie część, której regeneracja lub wymiana dotyczyła, to gwarantujemy priorytetowe załatwianie sprawy. Klient gwarancyjny obsługiwany jest poza kolejnością i bez oczekiwania na rozpatrzenie gwarancji przez producenta.'],
  },
  {
    question: 'Czy gwarancja obejmuje inne podzespoły niż naprawiane?',
    answer: [
      'Niestety nie. Gwarancja dotyczy wyłącznie części i podzespołów, które były zregenerowane lub wymienione. Przykładowo, jeśli wymienimy sprężarkę klimatyzacji, a po miesiącu rozszczelni się chłodnica, naprawa chłodnicy nie jest objęta gwarancją.',
      'Przykładowo jeśli zakupiona i zamontowana u nas chłodnica rozszczelni się, to na nasz koszt montujemy nową bez oczekiwania na rozpatrzenie reklamacji u producenta.',
    ],
  },
  {
    question: 'Naprawa a regeneracja sprężarki',
    answer: ['Aby gwarancja dotyczyła całej sprężarki, należy zdecydować się na kompleksową regenerację sprężarki. Naprawa sprężarki jest tańsza od regeneracji, ale gwarancja dotyczy tylko naprawionego podzespołu sprężarki.'],
  },
  {
    question: 'Części dostarczone przez klienta',
    answer: ['Gwarancja dotyczy tylko części zakupionych i zamontowanych w naszej firmie. Jeśli część dostarczona przez klienta ulegnie uszkodzeniu, konieczne będzie pokrycie kosztu ponownego demontażu, montażu i ewentualnego napełnienia czynnikiem.'],
  },
];
---

<BaseLayout
  title="Gwarancja — Klima-Kar"
  description="Warunki gwarancji na usługi serwisowe i części zamienne w Klima-Kar. 24 miesiące gwarancji na naprawy klimatyzacji samochodowej we Wrocławiu."
>
  <PageHero
    crumbs={[{ label: 'Strona główna', href: '/' }, { label: 'Gwarancja' }]}
    eyebrow="Informacje"
    title="Gwarancja"
    lead="Informacje dotyczące warunków gwarancji na usługi i części zamienne."
  />

  {terms.map((t) => (
    <ContentSection eyebrow="Gwarancja" title={t.title}>
      <ul class="kk-checklist">
        {t.items.map((item) => (
          <li><span class="kk-check"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{item}</span></li>
        ))}
      </ul>
    </ContentSection>
  ))}

  <FAQ eyebrow="Gwarancja" title="Szczegóły gwarancji" items={details} />

  <CTABanner
    title="Masz pytania dotyczące gwarancji?"
    subtitle="Zadzwoń: 71 337 14 50 — chętnie wyjaśnimy szczegóły."
    actionLabel="Skontaktuj się"
  />
</BaseLayout>
