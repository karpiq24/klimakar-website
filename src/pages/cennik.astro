---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PriceCards from '../components/PriceCards.astro';
import PriceGroup from '../components/PriceGroup.astro';
import CTABanner from '../components/CTABanner.astro';
import Today from '../components/Today.astro';

// "Ceny aktualne na dzień …" always shows today's date (owner's decision, 2026-10-13): the prices on
// this page are the ones in force, so when they change, change them here first.
const pricesYear = new Date().getFullYear();

// "Zakres obsługi układu klimatyzacji", word for word from the old site's cennik.
const scope = [
  'odzysk czynnika',
  'wykonanie próżni',
  'kontrola szczelności',
  'napełnienie czystym czynnikiem',
  'kontrola ciśnienia podczas pracy klimatyzacji',
  'kontrola wzrokowa oraz wydajnościowa układu klimatyzacji',
];
const scopeIfNeeded = [
  'identyfikacja i analiza czynnika w układzie',
  'uzupełnienie ubytku czynnika chłodniczego',
  'uzupełnienie oleju',
  'podanie barwnika UV',
  'opłukanie skraplacza z kurzu',
];
const check = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

const refrigerants = [
  { code: 'R134a', cars: 'Auta od 1993 r. do 2014 r. i niektóre po 2014 r.', price: '250 zł', extra: '+ 40 zł/100g powyżej 50g', service: 'Serwis układu, uzupełnienie czynnika R134a, oleju, UV' },
  { code: 'R1234yf', cars: 'Niektóre auta od 2014 r. i większość od 2017 r.', price: '300 zł', extra: '+ 10 zł/10g powyżej 50g', service: 'Serwis układu, uzupełnienie czynnika R1234yf, oleju, UV' },
  { code: 'R12', cars: 'Auta sprzed 1993 r.', price: '300 zł', extra: '+ 40 zł/100g powyżej 50g', service: 'Serwis układu, uzupełnienie czynnika zamiennik za R12, oleju, UV' },
  { code: 'R744', cars: 'Wybrane modele pojazdów', price: '900 zł', service: 'Serwis układu, napełnienie czynnika R744, oleju' },
];

const groups = [
  {
    title: 'Dezynfekcja',
    link: { label: 'Metody dezynfekcji →', href: '/dezynfekcja/' },
    rows: [
      { service: 'Dezynfekcja chemiczna metodą ultradźwiękową — preparat rozpylamy urządzeniem ultradźwiękowym w postaci mgiełki, przy włączonym nawiewie', price: '150 zł' },
      { service: 'Dezynfekcja TUNAP — preparat podajemy lancą natryskową bezpośrednio na parownik', price: '250 zł' },
    ],
  },
  {
    title: 'Diagnostyka usterek',
    rows: [
      { service: 'Diagnostyka komputerowa / Diagnostyka szczelności klimatyzacji', price: '250 zł' },
      { service: 'Diagnostyka kompresora na hamowni', price: '250 zł' },
    ],
  },
  {
    title: 'Naprawy',
    note: 'Do podanych cen należy doliczyć demontaż/montaż i napełnienie',
    rows: [
      { service: 'Naprawa przewodu aluminiowego', price: 'od 250 zł' },
      { service: 'Naprawa przewodu aluminiowo-gumowego', price: 'od 300 zł' },
      { service: 'Regeneracja kompresora (uszczelnienie + regeneracja kpl. sprzęgła)', price: 'od 1000 zł' },
      { service: 'Płukanie układu klimatyzacji z opiłków i brudnego oleju po zatarciu kompresora', price: 'od 1500 zł' },
    ],
  },
  {
    title: 'Robocizna',
    rows: [
      { service: 'Standardowa roboczogodzina', price: '250 zł' },
    ],
  },
  {
    title: 'Ogrzewanie postojowe',
    note: 'Montaż wyceniamy indywidualnie po podaniu danych pojazdu — orientacyjnie od 6.500 zł w przypadku ogrzewań powietrznych do busów, do kilkunastu tysięcy zł w przypadku skomplikowanych instalacji w autach osobowych.',
    rows: [
      { service: 'Diagnostyka ogrzewania postojowego Webasto lub Eberspächer', price: '250 zł brutto' },
    ],
  },
];
---

<BaseLayout
  title="Cennik klimatyzacji i ogrzewania postojowego — Klima-Kar Wrocław"
  description="Cennik usług serwisu klimatyzacji samochodowej i ogrzewań postojowych Klima-Kar we Wrocławiu. Przejrzyste ceny brutto."
>
  <PageHero
    crumbs={[{ label: 'Strona główna', href: '/' }, { label: 'Cennik' }]}
    eyebrow="Cennik"
    title={`Cennik usług ${pricesYear}`}
    lead="Przejrzyste ceny usług klimatyzacji samochodowej i ogrzewań postojowych."
  />

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="Klimatyzacja — samochody osobowe" title="Obsługa układu klimatyzacji">
      <span slot="aside" class="kk-chip"><span class="kk-dot"></span>Ceny aktualne na dzień <Today /></span>
    </SectionHeader>
    <PriceCards cards={refrigerants} columns={2} />
    <div class="kk-frost kk-price-group kk-scope">
      <h3 class="kk-price-title" style="margin:0 0 14px">Zakres obsługi układu klimatyzacji:</h3>
      <div class="kk-scope-cols">
        <ul>{scope.map((item) => <li><span class="kk-check" set:html={check} /><span>{item}</span></li>)}</ul>
        <div>
          <p class="kk-scope-sub">W razie potrzeby:</p>
          <ul>{scopeIfNeeded.map((item) => <li><span class="kk-check" set:html={check} /><span>{item}</span></li>)}</ul>
        </div>
      </div>
    </div>
    <div class="kk-price-groups">
      {groups.map((g) => <div><PriceGroup {...g} /></div>)}
    </div>
    <p class="kk-fineprint" style="margin-top:24px;text-align:center">Ceny brutto. Ceny aktualne na dzień <Today />.</p>
  </section>

  <CTABanner title="Masz pytania o cennik?" subtitle="Zadzwoń: 71 337 14 50 lub 605 594 506" />
</BaseLayout>

<script>
  // The hero year follows today's date too (the build year is the fallback).
  const heroTitle = document.querySelector('.kk-pagehero-title');
  if (heroTitle) heroTitle.textContent = `Cennik usług ${new Date().getFullYear()}`;
</script>

<style>
  .kk-scope {
    margin-top: 16px;
  }
  /* An odd last group spans the full row instead of leaving a hole. */
  .kk-price-groups > div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .kk-scope-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 40px;
  }
  .kk-scope ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kk-scope li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 9px 0;
    border-top: 1px solid var(--brand-line);
    color: var(--text-strong);
  }
  .kk-scope li:first-child {
    border-top: 0;
  }
  .kk-scope .kk-check {
    width: 24px;
    height: 24px;
    flex: none;
  }
  .kk-scope-sub {
    margin: 9px 0 0;
    font-weight: 600;
    color: var(--navy);
  }
  @container kk (max-width: 760px) {
    .kk-scope-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
