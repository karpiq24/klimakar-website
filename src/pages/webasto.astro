---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { CalendarCheck, Search, Wrench } from 'lucide-astro';

// Retired products (no longer sold, still serviced) go last and render greyed out.
const controlSystems: { name: string; type: string; retired?: boolean; image: string; features: string[] }[] = [
  {
    name: 'MultiControl',
    type: 'Programator z wyświetlaczem',
    image: '/images/MC.jpg',
    features: [
      'Menu w języku polskim',
      'Przejrzysty wyświetlacz i wygodny przycisk',
      '3 czasy włączania na dzień, programowanie na 7 dni',
      'Montaż możliwy bez wiercenia',
    ],
  },
  {
    name: 'Telestart T99',
    type: 'Pilot radiowy z potwierdzeniem',
    image: '/images/t99.webp',
    features: [
      'Zasięg do 1000 metrów',
      'Funkcja informacji zwrotnej',
      'Wybór grzania lub wentylacji (zima/lato)',
      'Czas działania od 10 do 120 minut',
      'Eleganckie wzornictwo, wytrzymała obudowa',
    ],
  },
  {
    name: 'Telestart T100',
    type: 'Pilot z wyświetlaczem',
    image: '/images/t100.jpg',
    features: [
      'Zasięg do 1000 metrów z informacją zwrotną',
      'Programowanie czasu odjazdu: pilot sam obliczy czas ogrzewania na podstawie temperatury i poziomu komfortu C1–C5',
      'Odczyt temperatury wnętrza pojazdu',
      'Prosta obsługa przyciskami On / Off i lewo / prawo',
      'Wybór grzania lub wentylacji (zima/lato)',
    ],
  },
  {
    name: 'ThermoConnect',
    type: 'Sterowanie przez internet',
    image: '/images/ThermoConnect.jpg',
    features: [
      'Aplikacja mobilna i webowa',
      'Timer jednorazowy i powtarzalny',
      'Uruchamianie oparte na pozycji GPS',
      'Lokalizacja pojazdu i geo-fencing',
      'Obsługa wielu urządzeń z jednej aplikacji',
      'Nie wymaga karty SIM',
      'W zestawie przycisk z diodą do szybkiego włączania i wyłączania ogrzewania',
      'Pierwszy rok bezpłatny, każdy kolejny — abonament 35 € rocznie',
    ],
  },
  {
    name: 'Telestart T91',
    type: 'Pilot radiowy',
    retired: true,
    image: '/images/t91.jpg',
    features: [
      'Zasięg do 1000 metrów',
      'Prosta obsługa przyciskami On / Off',
      'Wybór grzania lub wentylacji (zima/lato)',
      'Czas działania od 10 do 120 minut',
      'Eleganckie wzornictwo, wytrzymała obudowa',
    ],
  },
  {
    name: 'ThermoCall',
    type: 'Sterowanie GSM',
    retired: true,
    image: '/images/TC.png',
    features: [
      'Sterowanie z dowolnego miejsca w zasięgu GSM',
      'Bezpłatna aplikacja mobilna',
      'Programowanie z 24h wyprzedzeniem',
      'Informacja o statusie, temperaturze, napięciu',
      'Wymaga aktywnej karty SIM',
    ],
  },
];


const icon = { size: 24, 'stroke-width': 1.8, 'aria-hidden': 'true' };
---

<BaseLayout
  title="Autoryzowany serwis Webasto Wrocław — Klima-Kar"
  description="Autoryzowany Serwis Webasto we Wrocławiu. Montaż, naprawa i diagnostyka ogrzewań postojowych Webasto. Systemy sterowania MultiControl, Telestart, ThermoConnect."
>
  <PageHero
    crumbs={[
      { label: 'Strona główna', href: '/' },
      { label: 'Ogrzewanie postojowe', href: '/ogrzewanie-postojowe/' },
      { label: 'Webasto' },
    ]}
    eyebrow="Ogrzewanie postojowe"
    title="Autoryzowany Serwis Webasto"
    lead="Jesteśmy autoryzowanym serwisem Webasto. Nasze wieloletnie doświadczenie i wiedza pozwalają na wykonywanie profesjonalnych napraw i montaży nowych instalacji. Wykonujemy również naprawy gwarancyjne."
    image="/images/webastoauto.jpg"
    imageAlt="Montaż ogrzewania postojowego Webasto"
    tag="Autoryzowany serwis Webasto"
  />

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="Webasto" title="Nasze usługi" />
    <div class="kk-svc">
      <ServiceCard title="Montaż ogrzewań"
        text="Profesjonalny montaż nowych ogrzewań postojowych Webasto dla pojazdów osobowych i dostawczych. Dobieramy odpowiedni zestaw montażowy do każdego modelu pojazdu.">
        <Wrench {...icon} />
      </ServiceCard>
      <ServiceCard title="Naprawa i serwis"
        text="Naprawy gwarancyjne i pogwarancyjne. Diagnostyka komputerowa, wymiana podzespołów, naprawa instalacji. Diagnostyka usterek ogrzewań spalinowych.">
        <Search {...icon} />
      </ServiceCard>
      <ServiceCard title="Przegląd serwisowy"
        text="Regularne przeglądy serwisowe ogrzewań Webasto. Kontrola stanu technicznego, czyszczenie, sprawdzenie poprawności działania wszystkich podzespołów.">
        <CalendarCheck {...icon} />
      </ServiceCard>
    </div>
  </section>

  <section class="kk-wrap kk-section">
    <SectionHeader
      eyebrow="Webasto"
      title="Systemy sterowania Webasto"
      description="Wybierz sposób sterowania ogrzewaniem postojowym dopasowany do Twoich potrzeb — od prostego programatora po sterowanie smartfonem."
    />
    <div class="kk-products">
      {controlSystems.map((system) => (
        <ProductCard name={system.name} type={system.type} image={system.image} imageAlt={`Webasto ${system.name}`} features={system.features} retired={system.retired} />
      ))}
    </div>
  </section>

  <CTABanner title="Zapytaj o montaż lub naprawę Webasto" subtitle="tel. 71 337 14 50 · kom. 605 594 506" />
</BaseLayout>
