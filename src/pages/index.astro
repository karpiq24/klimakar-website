---
// Homepage — port of design/szron/homepage.dc.html (approved Szron design, markup and copy verbatim).
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Seasons from '../components/Seasons.astro';
import LogoStrip from '../components/LogoStrip.astro';
import PhotoPanel from '../components/PhotoPanel.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PartnerCard from '../components/PartnerCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import YearTimeline from '../components/YearTimeline.astro';
import ContactSection from '../components/ContactSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { Columns4, ShieldCheck, Search, Zap, Wrench } from 'lucide-astro';
import Komunikat from '../components/Komunikat.astro';

const gallery = [
  { src: '/images/galeria/lamb.JPG', alt: 'Serwis klimatyzacji w Lamborghini' },
  { src: '/images/galeria/merc.jpg', alt: 'Serwis klimatyzacji w Mercedesie' },
  { src: '/images/galeria/k2.jpg', alt: 'Naprawa klimatyzacji samochodowej' },
  { src: '/images/galeria/war.JPG', alt: 'Warsztat Klima-Kar we Wrocławiu' },
];

const years = [
  { year: '1989', label: 'Początki w chłodnictwie', src: '/images/tata.webp', alt: 'Krzysztof Karpiński, przyszły założyciel Klima-Kar, przy lodówce (1989)', position: '0% 30%' },
  { year: '1999', label: 'Start Klima-Kar', src: '/images/1999.webp', alt: 'Siedziba Klima-Kar przy ul. Grota-Roweckiego 129 w 1999 roku' },
  { year: '2008', label: 'Rozbudowa serwisu', src: '/images/galeria/war.JPG', alt: 'Warsztat Klima-Kar ze stanowiskami z podnośnikami' },
  { year: '2009', label: 'Autoryzacja Webasto i Eberspächer', src: '/images/2009-autoryzacja.webp', alt: 'Logo Webasto i Eberspächer' },
];

const icon = { size: 24, 'stroke-width': 1.8, 'aria-hidden': 'true' };
---

<BaseLayout
  title="Klima-Kar — klimatyzacja samochodowa i ogrzewanie postojowe Wrocław"
  description="Profesjonalny serwis klimatyzacji samochodowej oraz ogrzewań postojowych Webasto, Eberspächer i DEFA we Wrocławiu. Firma rodzinna z tradycją od 1989 roku."
>
  <!-- HERO -->
  <section class="kk-wrap kk-hero">
    <Komunikat />
    <Badge>Działamy od 1999 roku · Wrocław</Badge>
    <h1 class="kk-h1 kk-grad">Klimatyzacja i ogrzewanie Twojego auta</h1>
    <p class="kk-hero-tagline">Komfortowy klimat w zasięgu ręki</p>
    <p class="kk-lead">Profesjonalny serwis klimatyzacji samochodowej oraz ogrzewań postojowych Webasto, Eberspächer i DEFA we Wrocławiu.</p>
    <div class="kk-actions" data-callbar-hide>
      <a href="/kontakt/" class="kk-btn kk-btn--primary kk-btn--lg">Umów wizytę</a>
      <a href="/cennik/" class="kk-btn kk-btn--frost kk-btn--lg">Zobacz cennik</a>
    </div>
  </section>

  <!-- SEASONS + MONTH BANNER -->
  <Seasons />

  <!-- LOGO STRIP -->
  <LogoStrip />

  <!-- SERVICES -->
  <PhotoPanel
    season="summer"
    eyebrow="Usługi"
    title="Kompleksowy serwis klimatyzacji"
    description="Napełnianie, diagnostyka, naprawy i wymiana podzespołów. Obsługa czynników R134a, R1234yf, R744 oraz zamiennika R12."
    ctaLabel="Zobacz cennik →"
    ctaHref="/cennik/"
  >
    <div class="kk-svc">
      <ServiceCard variant="brand" title="Filtry kabinowe" chip="Od ręki" href="/klimatyzacja/"
        text="Mamy na miejscu duży wybór filtrów kabinowych — wymienimy od ręki, bez czekania na dostawę.">
        <Columns4 {...icon} />
      </ServiceCard>
      <ServiceCard title="Dezynfekcja klimatyzacji" href="/dezynfekcja/"
        text="TUNAP: preparat podajemy lancą natryskową bezpośrednio na parownik. Wykonujemy też dezynfekcję metodą ultradźwiękową.">
        <ShieldCheck {...icon} />
      </ServiceCard>
      <ServiceCard title="Diagnostyka i testy" href="/klimatyzacja/"
        text="Elektroniczne testy szczelności, diagnostyka komputerowa, kontrola UV. Sprawdzenie kompresora na hamowni.">
        <Search {...icon} />
      </ServiceCard>
      <ServiceCard variant="spotlight" title="R744 i auta elektryczne" chip="Doświadczenie w R744" href="/klimatyzacja/"
        tags={['R744 · CO₂', 'Mercedes Klasy S', 'Pompy ciepła', 'Hybrydy i EV']}
        text="Klimatyzacja na CO₂ (R744) trafia do coraz większej liczby aut. Mamy specjalistyczny sprzęt do układów R744 i duże doświadczenie w ich serwisie. Obsługujemy też klimatyzację aut elektrycznych i hybrydowych: elektryczne sprężarki wysokiego napięcia i układy z pompą ciepła, z użyciem dedykowanych olejów dielektrycznych.">
        <Zap {...icon} />
      </ServiceCard>
      <ServiceCard variant="image" title="Skuteczne naprawy" href="/klimatyzacja/" image="/images/galeria/k2.jpg"
        text="Uszkodzone elementy wymieniamy na nowe — sprężarki, skraplacze, parowniki, przewody, zawory rozprężne. Popularne części zamienne mamy na miejscu. Gdy nowa część nie wchodzi w grę, regenerujemy sprężarki i naprawiamy przewody.">
        <Wrench {...icon} />
      </ServiceCard>
    </div>
  </PhotoPanel>

  <!-- PARTNERS -->
  <PhotoPanel
    season="winter"
    eyebrow="Webasto · Eberspächer · DEFA"
    title="Ogrzewanie postojowe"
    description="Autoryzowani serwisanci Webasto i Eberspächer — oryginalne części i naprawy gwarancyjne. Sprzedaż i montaż systemów DEFA."
    ctaLabel="Dowiedz się więcej o ogrzewaniu postojowym →"
    ctaHref="/ogrzewanie-postojowe/"
  >
    <div class="kk-g3">
      <PartnerCard brand="webasto" href="/webasto/" kind="Niezależne ogrzewanie spalinowe" tags={['Autoryzowany serwis', 'Montaż', 'Naprawa']}
        text="Autoryzowany serwis ogrzewań postojowych Webasto — montaż nowych instalacji i naprawy, także gwarancyjne, dla pojazdów osobowych i dostawczych." />
      <PartnerCard brand="eberspacher" href="/eberspacher/" kind="Niezależne ogrzewanie spalinowe" tags={['Autoryzowany serwis', 'Montaż', 'Naprawa']}
        text="Profesjonalny serwis ogrzewań postojowych Eberspächer. Diagnostyka, wymiana podzespołów, naprawy. Autoryzowany serwis z wieloletnim doświadczeniem." />
      <PartnerCard brand="defa" href="/defa/" kind="Elektryczne ogrzewanie postojowe" tags={['Doradztwo', 'Montaż', 'Serwis']}
        text="Sprzedaż, montaż i serwis DEFA — elektryczne ogrzewanie silnika, wnętrza i ładowanie akumulatora. Idealne dla miejsc z dostępem do prądu." />
    </div>
  </PhotoPanel>

  <!-- HOW WE WORK -->
  <ProcessSteps>
    <a href="/jak-pracujemy/" class="kk-link">Zasady przyjmowania zleceń →</a>
  </ProcessSteps>

  <!-- GALLERY -->
  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="Galeria" title="Nasze realizacje">
      <a slot="aside" href="/galeria/" class="kk-link">Zobacz całą galerię →</a>
    </SectionHeader>
    <GalleryGrid images={gallery} href="/galeria/" />
  </section>

  <!-- ABOUT -->
  <section class="kk-wrap kk-section--lg kk-about">
    <div class="kk-about-media">
      <YearTimeline years={years} />
    </div>
    <div class="kk-about-text">
      <p class="kk-eyebrow">O nas</p>
      <h2 class="kk-h2" style="margin-bottom:22px">Firma rodzinna z tradycją od 1989</h2>
      <p style="margin:0 0 14px;color:var(--text-strong)">Jesteśmy firmą rodzinną z dwupokoleniową tradycją w branży chłodnictwa. W 1999 roku przyjęliśmy nazwę Klima-Kar i osiedliliśmy się przy ul. Grota-Roweckiego 129 we Wrocławiu.</p>
      <p class="kk-muted" style="margin:0 0 28px">Posiadamy autoryzacje Webasto i Eberspächer — co gwarantuje najwyższy standard usług i oryginalne części zamienne. Tysiące udanych napraw i zadowolonych klientów.</p>
      <div class="kk-actions">
        <a href="/o-firmie/" class="kk-btn kk-btn--primary">Historia firmy</a>
        <a href="/kontakt/" class="kk-btn kk-btn--frost">Kontakt</a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <ContactSection />
</BaseLayout>

<style>
  .kk-hero-tagline {
    margin: 22px auto 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.2cqi, 30px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--brand);
    text-wrap: balance;
  }
  .kk-hero-tagline + .kk-lead {
    margin-top: 16px;
  }
  .kk-about {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: center;
  }
  .kk-about-media {
    flex: 1 1 460px;
    min-width: 0;
  }
  .kk-about-text {
    flex: 1 1 420px;
    min-width: 0;
  }
</style>
