---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import ContentSection from '../components/ContentSection.astro';

const hours = [
  ['Poniedziałek - Piątek', '9:00 - 17:00'],
  ['Sobota', 'nieczynne'],
  ['Niedziela', 'nieczynne'],
];
---

<BaseLayout
  title="Kontakt — Klima-Kar, ul. Grota Roweckiego 129, Wrocław"
  description="Skontaktuj się z nami. Klima-Kar, ul. Grota Roweckiego 129, 52-214 Wrocław. Tel. 71 337 14 50."
>
  <PageHero
    crumbs={[{ label: 'Strona główna', href: '/' }, { label: 'Kontakt' }]}
    eyebrow="Kontakt"
    title="Skontaktuj się z nami"
    lead="Zapraszamy do kontaktu telefonicznego, mailowego lub osobistego. Chętnie odpowiemy na pytania i umówimy wizytę serwisową."
    actions={[
      { label: '71 337 14 50', href: 'tel:+48713371450' },
      { label: 'serwis@klima-kar.pl', href: 'mailto:serwis@klima-kar.pl' },
    ]}
  />

  <ContactSection intro={false} />

  <ContentSection eyebrow="Kontakt" title="Jak do nas dojechać?">
    <h3 class="kk-card-title">Dojazd samochodem</h3>
    <p>Nasz serwis znajduje się przy ul. Grota Roweckiego 129 we Wrocławiu, w dzielnicy Krzyki. Wjazd od strony ul. Grota Roweckiego. Parking dla klientów dostępny na miejscu.</p>
    <h3 class="kk-card-title">Godziny otwarcia</h3>
    <div style="max-width:420px">
      {hours.map(([day, time]) => (
        <div class="kk-price-row"><span class="kk-price-item">{day}</span><span class="kk-price-dots" aria-hidden="true"></span><span class="kk-price-value">{time}</span></div>
      ))}
    </div>
  </ContentSection>
</BaseLayout>
