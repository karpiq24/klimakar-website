---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentSection from '../components/ContentSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureList from '../components/FeatureList.astro';
import CTABanner from '../components/CTABanner.astro';

const modules = [
  {
    title: 'Podgrzewacz silnika',
    description: 'Do większości jednostek napędowych występuje specjalnie dedykowana grzałka silnika. Rozruch wstępnie podgrzanego silnika jest łatwiejszy i oznacza istotne zmniejszenie zużycia paliwa, a także obniżenie zużycia samego silnika w porównaniu do startu „na zimno".',
    icon: 'thermometer',
    image: '/images/defa-silnik.png',
    imageAlt: 'DEFA — podgrzewacz silnika',
  },
  {
    title: 'Ogrzewacz wnętrza',
    description: 'Ogrzewacz wnętrza zapewnia komfortową temperaturę wnętrza pojazdu. Ciepłe wnętrze pozwala zapomnieć o parowaniu szyb i porannym skrobaniu lodu. Bezpiecznie jest jeździć z czystymi i odlodzonymi szybami.',
    icon: 'fan',
    image: '/images/defa-wnetrze.png',
    imageAlt: 'DEFA — ogrzewacz wnętrza pojazdu',
  },
  {
    title: 'Ładowarka akumulatora',
    description: 'Elektroniczna ładowarka daje pewność naładowanego do pełna akumulatora. Zaawansowana elektronika zapobiega przeładowaniu, a akumulator jest prawidłowo ładowany niezależnie od temperatury na zewnątrz.',
    icon: 'battery',
    image: '/images/defa-ladowanie.png',
    imageAlt: 'DEFA — ładowanie akumulatora',
  },
];

const benefits = [
  'Ograniczenie szkodliwych emisji spalin',
  'Mniejsze zużycie silnika przy rozruchu',
  'Oszczędność paliwa na zimnym starcie',
  'Komfortowe warunki od pierwszej chwili',
];
---

<BaseLayout
  title="DEFA — Klima-Kar"
  description="Elektryczne ogrzewanie postojowe DEFA we Wrocławiu. Sprzedaż, montaż i serwis systemów DEFA WarmUp — podgrzewacz silnika, ogrzewacz wnętrza, ładowarka akumulatora."
>
  <PageHero
    crumbs={[
      { label: 'Strona główna', href: '/' },
      { label: 'Ogrzewanie postojowe', href: '/ogrzewanie-postojowe/' },
      { label: 'DEFA' },
    ]}
    eyebrow="Ogrzewanie postojowe"
    title="Ogrzewanie elektryczne DEFA"
    lead="Oferujemy sprzedaż części i montaż systemów ogrzewania DEFA, a także obsługę i rozbudowę istniejących instalacji. System DEFA WarmUp wymaga zasilania z sieci 230V."
    image="/images/defa-warmup.jpg"
    imageAlt="Samochód podłączony do ogrzewania DEFA na zaśnieżonym parkingu"
    imagePosition="40% 50%"
    tag="DEFA WarmUp · 230V"
  />

  <ContentSection eyebrow="DEFA" title="System DEFA WarmUp">
    <p>Elektryczne ogrzewanie postojowe DEFA do działania wymaga zasilania prądem przemiennym z sieci 230V. Kompletny system DEFA WarmUp składa się z grzałki silnika, ogrzewacza wnętrza, elektronicznej ładowarki akumulatora i jednostki sterującej.</p>
    <p>Zaletą systemu DEFA WarmUp jest jego modułowa budowa pozwalająca na dostosowanie systemu do potrzeb i wymagań użytkownika. Nic nie stoi na przeszkodzie, by wyposażyć pojazd wyłącznie w grzałkę silnika.</p>
    <Fragment slot="callout-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-5M9 8V2M15 8V2M18 8v5a6 6 0 0 1-12 0V8z"></path></svg></Fragment>
    <Fragment slot="callout"><strong>Wymaga dostępu do sieci 230V w miejscu postoju.</strong> System DEFA jest idealnym rozwiązaniem dla osób posiadających garaż lub miejsce parkingowe z dostępem do gniazdka elektrycznego.</Fragment>
  </ContentSection>

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="DEFA WarmUp" title="Moduły systemu DEFA" />
    <div class="kk-products">
      {modules.map((mod) => (
        <ProductCard name={mod.title} image={mod.image} imageAlt={mod.imageAlt} description={mod.description} />
      ))}
    </div>
  </section>

  <FeatureList season="winter" eyebrow="DEFA" title="Korzyści" items={benefits} image="/images/defa-warmup.jpg" imageAlt="Samochód podłączony do ogrzewania DEFA na zaśnieżonym parkingu" />

  <CTABanner title="Zapytaj o montaż systemu DEFA" subtitle="tel. 71 337 14 50 · kom. 605 594 506" />
</BaseLayout>
