---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentSection from '../components/ContentSection.astro';
import FeatureList from '../components/FeatureList.astro';
import CTABanner from '../components/CTABanner.astro';

const serviceScope = [
  'Kontrola wzrokowa elementów układu',
  'Kontrola działania, wydajności i szczelności',
  'Wymiana filtra kabinowego przeciwpyłkowego',
  'Dezynfekcja — odgrzybianie parownika',
  'Uzupełnienie czynnika chłodniczego, oleju i barwnika UV',
];
---

<BaseLayout
  title="Konserwacja klimatyzacji — Klima-Kar"
  description="Dlaczego warto regularnie serwisować klimatyzację samochodową? Poradnik konserwacji układu klimatyzacji — zdrowie, bezpieczeństwo, oszczędności."
>
  <PageHero
    crumbs={[
      { label: 'Strona główna', href: '/' },
      { label: 'Klimatyzacja', href: '/klimatyzacja/' },
      { label: 'Konserwacja' },
    ]}
    eyebrow="Poradnik"
    title="Konserwacja klimatyzacji"
    lead="Regularna konserwacja klimatyzacji pozwala uniknąć poważnych awarii, zaoszczędzić pieniądze i podwyższa wartość pojazdu."
    image="/images/merc2.jpg"
    imageAlt="Realizacja serwisu klimatyzacji w Mercedesie"
    tag="Co 12 miesięcy"
    actions={[{ label: 'Umów wizytę', href: '/kontakt/' }, { label: 'Zobacz cennik', href: '/cennik/' }]}
  />

  <ContentSection eyebrow="Konserwacja" title="Dlaczego coroczny serwis jest ważny?">
    <p>Przez węże i ich połączenia może uciec rocznie do 10% czynnika chłodniczego. Olej zawarty w czynniku smaruje sprężarkę — jego brak oznacza ryzyko niedostatecznego smarowania, co może skończyć się całkowitą awarią układu. Koszty naprawy mogą sięgać kilku tysięcy złotych. Niedobór czynnika powoduje też dodatkowe zużycie paliwa, ponieważ sprężarka musi pracować częściej i dłużej.</p>
  </ContentSection>

  <FeatureList season="summer" eyebrow="Konserwacja" title="Co obejmuje prawidłowy serwis?" items={serviceScope} />

  <ContentSection eyebrow="Konserwacja" title="Zdrowie i higiena">
    <p>Filtr pyłkowy przepuszcza duże ilości powietrza, zatrzymując pył, kurz i zarodniki — po roku jest nasycony i wymaga wymiany. Parownik, znajdujący się w wilgotnym i ciemnym otoczeniu pod tablicą rozdzielczą, stanowi idealną przestrzeń dla bakterii i grzybów. Zarazki przechodzą przez wentylację do wnętrza pojazdu, mogąc wywoływać reakcje alergiczne: kichanie, kaszel, łzawienie oczu. Regularna dezynfekcja parownika trwale usuwa zarazki.</p>
  </ContentSection>

  <ContentSection eyebrow="Konserwacja" title={"Bezpieczeń\u00ADstwo jazdy"}>
    <p>Gdy we wnętrzu pojazdu jest gorąco, organizm szybciej ulega zmęczeniu — reakcje są spowolnione, koncentracja słabsza, co znacząco zwiększa ryzyko wypadku. Sprawna klimatyzacja zapewnia odpowiednią temperaturę. Zimą włączenie klimatyzacji skutecznie przeciwdziała zaparowaniu szyb, zapewniając niczym nie ograniczoną widoczność.</p>
  </ContentSection>

  <ContentSection eyebrow="Konserwacja" title="Kiedy serwisować klimatyzację?">
    <p>Klimatyzację należy serwisować <strong>co 12 miesięcy</strong> lub wtedy, gdy zauważysz spadek wydajności chłodzenia. Używane pojazdy z działającą klimatyzacją osiągają wyższą cenę odsprzedaży — pieniądze zainwestowane w regularną konserwację zwiększają wartość pojazdu i zwracają się przy odsprzedaży. Konserwacja powinna być wykonywana tylko w fachowych warsztatach posiadających specjalne narzędzia i przeszkolony personel.</p>
  </ContentSection>

  <CTABanner title="Umów przegląd klimatyzacji" subtitle="Zadzwoń: 71 337 14 50 lub 605 594 506" />
</BaseLayout>
