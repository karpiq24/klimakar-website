---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import StatGrid from '../components/StatGrid.astro';
import CTABanner from '../components/CTABanner.astro';

const history = [
  { year: "1989", title: "Początek wolnej Polski i początki w chłodnictwie", description: "W tamtym czasie zajmowaliśmy się serwisem zmechanizowanego sprzętu gospodarstwa domowego. Na zdjęciu, przy lodówce stoi przyszły założyciel Klima-Kar – Krzysztof Karpiński.", image: "/images/tata.webp", imageAlt: "Krzysztof Karpiński, przyszły założyciel Klima-Kar, przy lodówce", imagePosition: "0% 30%" },
  { year: "1993", title: "Klimatyzacja samochodowa", description: "Wprowadziliśmy do swojej oferty pełną obsługę urządzeń klimatyzacyjnych w samochodach osobowych i dostawczych.", image: "/images/manometry50p.webp", imageAlt: "Manometry do obsługi klimatyzacji samochodowej" },
  { year: "1999", title: "Klima-Kar", description: "Od roku 1999 firma nosi nazwę Klima-Kar i ma siedzibę przy ulicy Grota Roweckiego 129 we Wrocławiu. Od tej chwili skupiliśmy się na klimatyzacjach samochodowych.", image: "/images/1999.webp", imageAlt: "Siedziba Klima-Kar w roku 1999" },
  { year: "2008", title: "Rozwój", description: "Rozbudowaliśmy nasz serwis o dwa stanowiska z podnośnikami. Dodatkowo wprowadziliśmy do oferty naprawy i montaż ogrzewań postojowych Webasto i Eberspächer.", image: "/images/galeria/war.JPG", imageAlt: "Warsztat Klima-Kar we Wrocławiu" },
  { year: "2009", title: "Autoryzacja Webasto i Eberspächer", description: "Staliśmy się Autoryzowanym Serwisem Webasto i Autoryzowanym Serwisem Eberspächer.", image: "/images/2009-autoryzacja.webp", imageAlt: "Logo Webasto i Eberspächer" },
  { year: "Dziś", title: "Nasz zespół jest tu dla Ciebie", description: "Zakresem naszej działalności są klimatyzacje samochodowe oraz ogrzewania postojowe Webasto, Eberspächer i DEFA. Zapewniamy pełną i profesjonalną obsługę serwisową.", image: "/images/dron-1-1536x960.webp", imageAlt: "Widok z lotu ptaka na siedzibę Klima-Kar we Wrocławiu" },
];

const stats = [
  { value: '1989', label: 'początki w chłodnictwie' },
  { value: '2', label: 'autoryzacje partnerskie' },
  { value: 'Wrocław', label: 'siedziba od 1999' },
  { value: 'Rodzinna', label: 'firma dwupokoleniowa' },
];
---

<BaseLayout
  title="O firmie — Klima-Kar Wrocław, od 1999 roku"
  description="Klima-Kar — firma rodzinna z dwupokoleniową tradycją w branży chłodnictwa we Wrocławiu."
>
  <PageHero
    crumbs={[{ label: 'Strona główna', href: '/' }, { label: 'O firmie' }]}
    eyebrow="O firmie"
    title={"Firma rodzinna z dwu\u00ADpokoleniową tradycją"}
    lead="Jesteśmy firmą rodzinną z dwupokoleniową tradycją w branży chłodnictwa. Nasza pasja i zaangażowanie sprawiają, że jesteśmy liderem w naprawach klimatyzacji samochodowej we Wrocławiu."
    image="/images/galeria/szyld.JPG"
    imageAlt="Szyld serwisu Klima-Kar we Wrocławiu"
    tag="Klima-Kar od 1999"
  />

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="O firmie" title="Historia firmy" />
    <HistoryTimeline items={history} />
  </section>

  <StatGrid
    eyebrow="O firmie"
    title="Dlaczego Klima-Kar?"
    paragraphs={[
      'Wyróżnia nas wieloletnie doświadczenie, które pozwala nam świadczyć usługi na najwyższym poziomie. Przeprowadziliśmy niezliczoną ilość interwencji serwisowych, czynności obsługowych i skomplikowanych napraw.',
      'Nasz zespół składa się z wykwalifikowanych specjalistów, którzy posiadają bogate doświadczenie w diagnozowaniu i naprawianiu układów klimatyzacji w różnorodnych pojazdach.',
      'Dajemy pewność, że Państwa pojazdem zajmie się osoba odpowiednio przeszkolona. Zapewniamy pełną i profesjonalną obsługę serwisową.',
    ]}
    stats={stats}
    ctaLabel="Skontaktuj się z nami"
    ctaHref="/kontakt/"
  />

  <CTABanner
    title="Skontaktuj się z nami"
    subtitle="Zadzwoń, napisz lub odwiedź nas osobiście. Jesteśmy do Twojej dyspozycji."
  />
</BaseLayout>
