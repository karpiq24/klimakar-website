---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { CalendarCheck, Search, Wrench } from 'lucide-astro';

const controlSystems = [
  {
    name: 'EasyStart Select',
    type: 'Włącznik z wyświetlaczem',
    image: '/images/ess.jpg',
    features: [
      'Prosta funkcja włączania i wyłączania jednym przyciskiem',
      'Funkcja wyświetlania informacji zwrotnej',
      'Przejrzysty wyświetlacz i wygodne przyciski',
      'Odczyt nastawionej i aktualnej temperatury',
      'Zalecany do ogrzewań powietrznych',
    ],
  },
  {
    name: 'EasyStart Timer',
    type: 'Programator tygodniowy',
    image: '/images/est.jpg',
    features: [
      'Programowanie w cyklu tygodniowym',
      'Możliwość ustawienia trzech programów',
      'Przejrzysty wyświetlacz i wygodne przyciski',
      'Funkcja informacji zwrotnej',
      'Wybór czasu pracy ogrzewania',
    ],
  },
  {
    name: 'EasyStart Pro',
    type: 'Element sterujący z wyświetlaczem',
    image: '/images/esp.jpg',
    features: [
      'Obsługa jednym przyciskiem — obrót i naciśnięcie',
      'Wyświetlacz: stan pracy, temperatura we wnętrzu, programator',
      'Kolorowy pierścień LED wskazuje tryb pracy',
      'Do trzech programów czasowych w tygodniu',
      'Czas pracy od 10 do 120 minut lub ogrzewanie ciągłe',
      'Sterowanie maksymalnie dwoma urządzeniami grzewczymi',
    ],
  },
  {
    name: 'EasyStart Remote',
    type: 'Pilot radiowy',
    image: '/images/esr.jpg',
    features: [
      'Zasięg do 1000 metrów',
      'Funkcja informacji zwrotnej',
      'Prosta obsługa przyciskami Wł. / Wył.',
      'Wybór grzania lub wentylacji (zima/lato)',
      'Czas działania od 10 do 60 minut',
    ],
  },
  {
    name: 'EasyStart Remote+',
    type: 'Pilot z wyświetlaczem i programowaniem',
    image: '/images/esr+.jpg',
    features: [
      'Zasięg do 1000 metrów z informacją zwrotną',
      'Programowanie czasu odjazdu (automatyczne)',
      'Trzy programy w cyklu tygodniowym',
      'Odczyt temperatury wnętrza pojazdu',
      'Wybór grzania lub wentylacji (zima/lato)',
    ],
  },
  {
    name: 'EasyStart Web',
    type: 'Sterowanie przez internet',
    image: '/images/esw.jpg',
    features: [
      'Sterowanie z dowolnego miejsca przez internet',
      'Bezpłatna aplikacja na smartfony',
      'Sterowanie przez przeglądarkę internetową',
      'Automatyczne programowanie czasu odjazdu',
      'Informacja o statusie i temperaturze wnętrza',
      'Nie wymaga karty SIM',
      'W zestawie przycisk z diodą do szybkiego włączania i wyłączania ogrzewania',
      'Wymaga abonamentu — 129 zł rocznie (cena na dzień {dzisiaj})',
    ],
  },
];


const icon = { size: 24, 'stroke-width': 1.8, 'aria-hidden': 'true' };
---

<BaseLayout
  title="Autoryzowany serwis Eberspächer Wrocław — Klima-Kar"
  description="Autoryzowany Serwis Eberspächer we Wrocławiu. Montaż, naprawa i diagnostyka ogrzewań postojowych Eberspächer. Systemy sterowania EasyStart."
>
  <PageHero
    crumbs={[
      { label: 'Strona główna', href: '/' },
      { label: 'Ogrzewanie postojowe', href: '/ogrzewanie-postojowe/' },
      { label: 'Eberspächer' },
    ]}
    eyebrow="Ogrzewanie postojowe"
    title="Autoryzowany Serwis Eberspächer"
    lead="Jesteśmy autoryzowanym serwisem Eberspächer. Nasze wieloletnie doświadczenie i wiedza pozwalają na wykonywanie profesjonalnych napraw i montaży nowych instalacji. Wykonujemy również naprawy gwarancyjne."
    image="/images/eberspacher-zima.jpg"
    imageAlt="Ciepłe auto bez śniegu obok zaśnieżonego samochodu"
    tag="Autoryzowany serwis Eberspächer"
  />

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="Eberspächer" title="Nasze usługi" />
    <div class="kk-svc">
      <ServiceCard title="Montaż ogrzewań"
        text="Profesjonalny montaż nowych ogrzewań postojowych Eberspächer dla pojazdów osobowych i dostawczych. Dobieramy odpowiedni zestaw montażowy do każdego modelu pojazdu.">
        <Wrench {...icon} />
      </ServiceCard>
      <ServiceCard title="Naprawa i serwis"
        text="Naprawy gwarancyjne i pogwarancyjne. Diagnostyka komputerowa, wymiana podzespołów, naprawa instalacji. Diagnostyka usterek ogrzewań spalinowych.">
        <Search {...icon} />
      </ServiceCard>
      <ServiceCard title="Przegląd serwisowy"
        text="Regularne przeglądy serwisowe ogrzewań Eberspächer. Kontrola stanu technicznego, czyszczenie, sprawdzenie poprawności działania wszystkich podzespołów.">
        <CalendarCheck {...icon} />
      </ServiceCard>
    </div>
  </section>

  <section class="kk-wrap kk-section">
    <SectionHeader
      eyebrow="Eberspächer"
      title="Systemy sterowania Eberspächer"
      description="Wybierz sposób sterowania ogrzewaniem postojowym dopasowany do Twoich potrzeb — od prostego włącznika po sterowanie smartfonem."
    />
    <div class="kk-products">
      {controlSystems.map((system) => (
        <ProductCard name={system.name} type={system.type} image={system.image} imageAlt={`Eberspächer ${system.name}`} features={system.features} />
      ))}
    </div>
  </section>

  <CTABanner title="Zapytaj o montaż lub naprawę Eberspächer" subtitle="tel. 71 337 14 50 · kom. 605 594 506" />
</BaseLayout>
