---
// /panel/ — the owner's panel for the notice and the extra days off (owner, 2026-10-17). A static page that
// talks to public/panel/api.php; the result is www/status.json, read by all three sites. Not in the
// sitemap, noindex, disallowed in robots.txt; no GTM, header or footer. Works only on the production
// server (PHP); on the demo it says so.
import '../../styles/global.css';
import '../../styles/szron.css';
import { Plus, Trash2 } from 'lucide-astro';
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Panel — Klima-Kar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="kk-root kk-dots">
      <div aria-hidden="true" class="kk-glow kk-glow--top-ice kk-drift"></div>
      <div aria-hidden="true" class="kk-glow kk-glow--top-brand kk-drift2"></div>
      <main class="kk-wrap pn">
        <a href="/" class="pn-logo"><img src="/images/brand/logo-color.svg" alt="Klima-Kar — strona główna" width="150" height="36"></a>
        <p class="kk-eyebrow">Panel</p>
        <h1 class="kk-h2">Komunikat i dni wolne</h1>

        <p class="kk-toast" id="pn-offline" role="status" hidden>Panel działa tylko na serwerze klima-kar.wroclaw.pl.</p>

        <form class="kk-form" id="pn-login" hidden>
          <label class="kk-field">Hasło<input id="pn-password" class="kk-input" type="password" autocomplete="current-password" required></label>
          <button type="submit" class="kk-btn kk-btn--primary kk-btn--lg">Zaloguj</button>
          <p class="kk-toast" data-msg role="status" aria-live="polite" hidden></p>
        </form>

        <form class="kk-form" id="pn-edit" hidden>
          <section class="pn-part">
            <h2 class="kk-h3">Komunikat</h2>
            <p class="kk-muted pn-hint">Pokazuje się na górze strony głównej oraz stron Webasto i Eberspächer, dopóki pole nie jest puste. Daty poniżej go nie zmieniają.</p>
            <label class="kk-field">Treść komunikatu
              <textarea id="pn-text" class="kk-input" rows="3" maxlength="300" placeholder="np. W dniach 27–31 grudnia nasza firma będzie nieczynna."></textarea>
            </label>
            <div class="pn-row-end"><span class="pn-count" id="pn-count">0 / 300</span><button type="button" class="pn-link" id="pn-clear">Wyczyść komunikat</button></div>
          </section>

          <section class="pn-part">
            <h2 class="kk-h3">Dodatkowe dni wolne</h2>
            <p class="kk-muted pn-hint">Święta ustawowe są uwzględnione automatycznie. Wpisz tylko dodatkowe dni, np. urlop albo przerwę świąteczną. W te dni strona pokazuje „Teraz nieczynne” i podaje najbliższy dzień otwarcia. Jeden dzień: wypełnij tylko „Od”. Minione daty znikają same po zapisaniu.</p>
            <div id="pn-days" class="pn-days"></div>
            <p class="kk-muted pn-empty" id="pn-empty">Brak dodatkowych dni wolnych.</p>
            <button type="button" class="kk-btn kk-btn--frost kk-btn--sm pn-add" id="pn-add"><Plus size={18} stroke-width={2} aria-hidden="true" />Dodaj dzień lub okres</button>
          </section>

          <button type="submit" class="kk-btn kk-btn--primary kk-btn--lg">Zapisz zmiany</button>
          <p class="kk-toast" data-msg role="status" aria-live="polite" hidden></p>
          <div class="pn-row-end">
            <span class="kk-fineprint" id="pn-changed"></span>
            <button type="button" class="pn-link" id="pn-logout">Wyloguj</button>
          </div>
        </form>

        <template id="pn-day">
          <div class="pn-day">
            <label class="kk-field">Od<input class="kk-input" type="date" data-od required></label>
            <label class="kk-field">Do (opcjonalnie)<input class="kk-input" type="date" data-do></label>
            <button type="button" class="kk-round pn-remove" aria-label="Usuń"><Trash2 size={20} stroke-width={1.8} aria-hidden="true" /></button>
          </div>
        </template>
      </main>
    </div>
  </body>
</html>

<script>
  interface DayOff { od: string; do?: string }
  interface State { zalogowany: boolean; csrf?: string; dane?: { komunikat: string; dniWolne: DayOff[]; zmieniono: string | null }; error?: string }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const login = $<HTMLFormElement>('pn-login');
  const edit = $<HTMLFormElement>('pn-edit');
  const text = $<HTMLTextAreaElement>('pn-text');
  const days = $('pn-days');
  const template = $<HTMLTemplateElement>('pn-day');
  let csrf = '';

  function say(form: HTMLFormElement, message: string, ok = false) {
    const box = form.querySelector<HTMLElement>('[data-msg]')!;
    box.textContent = message;
    box.dataset.state = ok ? 'ok' : 'error';
    box.hidden = !message;
  }

  async function api(body?: object): Promise<State> {
    const response = await fetch('api.php', body
      ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' }
      : { credentials: 'same-origin', cache: 'no-store' });
    const data = (await response.json()) as State;
    if (!response.ok && !data.error) data.error = 'Wystąpił błąd. Spróbuj ponownie.';
    return data;
  }

  const sync = () => {
    $('pn-count').textContent = `${text.value.length} / 300`;
    $('pn-empty').hidden = days.children.length > 0;
  };

  function addDay(day?: DayOff) {
    const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const from = row.querySelector<HTMLInputElement>('[data-od]')!;
    const to = row.querySelector<HTMLInputElement>('[data-do]')!;
    from.value = day?.od ?? '';
    to.value = day?.do ?? '';
    from.addEventListener('change', () => (to.min = from.value));
    to.min = from.value;
    row.querySelector('.pn-remove')!.addEventListener('click', () => { row.remove(); sync(); });
    days.append(row);
    sync();
    return from;
  }

  function show(state: State) {
    login.hidden = state.zalogowany;
    edit.hidden = !state.zalogowany;
    if (!state.zalogowany || !state.dane) return;
    csrf = state.csrf ?? '';
    text.value = state.dane.komunikat;
    days.replaceChildren();
    state.dane.dniWolne.forEach((d) => addDay(d));
    const changed = state.dane.zmieniono ? new Date(state.dane.zmieniono) : null;
    $('pn-changed').textContent = changed ? `Ostatnia zmiana: ${changed.toLocaleString('pl-PL', { dateStyle: 'long', timeStyle: 'short' })}` : '';
    sync();
  }

  login.addEventListener('submit', async (e) => {
    e.preventDefault();
    say(login, '');
    const state = await api({ akcja: 'zaloguj', haslo: $<HTMLInputElement>('pn-password').value }).catch(() => ({ zalogowany: false, error: 'Brak połączenia z serwerem.' }));
    if (state.error) return say(login, state.error);
    $<HTMLInputElement>('pn-password').value = '';
    show(state);
  });

  edit.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!edit.reportValidity()) return;
    const dniWolne = [...days.children].map((row) => ({
      od: row.querySelector<HTMLInputElement>('[data-od]')!.value,
      do: row.querySelector<HTMLInputElement>('[data-do]')!.value,
    }));
    const state = await api({ akcja: 'zapisz', csrf, komunikat: text.value, dniWolne }).catch(() => ({ zalogowany: true, error: 'Brak połączenia z serwerem. Zmiany nie zostały zapisane.' }));
    if (state.error) {
      if (state.zalogowany === false) show(state);
      return say(state.zalogowany === false ? login : edit, state.error);
    }
    show(state);
    say(edit, 'Zapisano. Zmiany są widoczne na stronach od razu (po odświeżeniu strony).', true);
  });

  $('pn-add').addEventListener('click', () => addDay().focus());
  $('pn-clear').addEventListener('click', () => { text.value = ''; sync(); text.focus(); });
  text.addEventListener('input', sync);
  $('pn-logout').addEventListener('click', async () => {
    await api({ akcja: 'wyloguj', csrf }).catch(() => null);
    show({ zalogowany: false });
    say(edit, '');
  });

  api().then(show).catch(() => ($('pn-offline').hidden = false));
</script>

<style>
  .pn {
    position: relative;
    max-width: 760px;
    padding-top: 40px;
    padding-bottom: 80px;
  }
  .pn-logo {
    display: inline-block;
    margin-bottom: 36px;
  }
  .pn-logo img {
    display: block;
    height: 36px;
    width: auto;
  }
  .pn .kk-h2 {
    margin-bottom: 28px;
  }
  .pn-part {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--brand-line);
  }
  .pn-hint {
    margin: 0;
    font-size: 15px;
  }
  .pn-row-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
  }
  .pn-count {
    font-size: 13px;
    color: var(--text-subtle);
  }
  .pn-link {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand);
    text-decoration: underline;
    cursor: pointer;
  }
  .pn-days {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pn-days:empty {
    display: none;
  }
  .pn-empty {
    margin: 0;
    font-size: 15px;
  }
  .pn-day {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 10px;
    align-items: end;
    border-radius: var(--radius-icon);
    padding: 12px;
    background: var(--brand-tint);
  }
  .pn-remove {
    width: 48px;
    height: 48px;
    border: 1px solid var(--brand-field-line);
    background: var(--field);
    color: var(--brand);
    cursor: pointer;
  }
  .pn-add {
    align-self: flex-start;
    gap: 8px;
  }
  .kk-toast {
    margin: 0;
    border-radius: var(--radius-card-sm);
    padding: 16px 20px;
    background: var(--frost-form);
    font-weight: 600;
    color: var(--navy);
    box-shadow: var(--shadow-form);
  }
  .kk-toast[data-state='ok'] {
    background: var(--brand-tint);
    color: var(--brand);
    box-shadow: none;
  }
  @container kk (max-width: 520px) {
    .pn-day {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .pn-day .kk-field:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    .pn-remove {
      grid-row: 1 / 3;
      grid-column: 2;
      align-self: center;
    }
  }
</style>
