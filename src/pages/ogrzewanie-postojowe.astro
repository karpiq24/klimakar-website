---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoPanel from '../components/PhotoPanel.astro';
import PartnerCard from '../components/PartnerCard.astro';
import FeatureList from '../components/FeatureList.astro';
import ContentSection from '../components/ContentSection.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Car, Truck } from 'lucide-astro';

const icon = { size: 24, 'stroke-width': 1.8, 'aria-hidden': 'true' };

const brands = [
  {
    brand: 'webasto' as const,
    kind: 'Niezależne ogrzewanie spalinowe',
    text: 'Jesteśmy Autoryzowanym Serwisem Webasto. Nasze wieloletnie doświadczenie i wiedza pozwalają na wykonywanie profesjonalnych napraw i montaży nowych instalacji dla pojazdów osobowych i dostawczych.',
    tags: ['Autoryzowany serwis', 'Montaż', 'Naprawa', 'Gwarancja'],
    href: '/webasto/',
  },
  {
    brand: 'eberspacher' as const,
    kind: 'Niezależne ogrzewanie spalinowe',
    text: 'Autoryzowany Serwis Eberspächer. Profesjonalne naprawy i montaże ogrzewań spalinowych. Pełna diagnostyka komputerowa, wymiana podzespołów, naprawy gwarancyjne i pogwarancyjne.',
    tags: ['Autoryzowany serwis', 'Montaż', 'Naprawa', 'Diagnostyka'],
    href: '/eberspacher/',
  },
  {
    brand: 'defa' as const,
    kind: 'Elektryczne ogrzewanie postojowe',
    text: 'Polecamy osobom posiadającym dostęp do sieci elektrycznej w miejscu postoju. DEFA pozwala ogrzać wnętrze pojazdu i silnik, a także naładować akumulator. Oferujemy doradztwo i montaż.',
    tags: ['Doradztwo', 'Montaż', 'Serwis'],
    href: '/defa/',
  },
];

// Which heater for whom: water (wet) vs air (dry) heaters, with the matching kind of customer.
const types = [
  {
    kind: 'Ogrzewanie wodne',
    title: 'Komfort w aucie osobowym i ochrona silnika',
    who: 'Klient indywidualny · auta osobowe',
    items: [
      'Nagrzany silnik, ciepłe wnętrze i odmrożone szyby rano',
      'Mniejsze zużycie elementów silnika podczas rozruchu',
      'Sterowanie z aplikacji: Webasto ThermoConnect lub Eberspächer EasyStart Web',
    ],
  },
  {
    kind: 'Ogrzewanie powietrzne',
    title: 'Ciepła kabina w busie, dostawczaku i kamperze',
    who: 'Firmy, floty, kampery · auta dostawcze, busy, pojazdy specjalne',
    items: [
      'Niezawodne ciepło w kabinie w trasie i na postoju, także do spania w pojeździe',
      'Montaż pod fotelem lub w zabudowie',
      'Serwis w trybie pilnym',
    ],
  },
];
const check = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

const benefits = [
  'Podgrzany do odpowiedniej temperatury silnik — brak efektu zimnego startu.',
  'Ciepłe i przyjazne warunki wewnątrz pojazdu natychmiast po wejściu.',
  'Czyste szyby — bezpieczne, suche i odlodzone.',
  'Mniejsze zużycie elementów silnika podczas rozruchu.',
  'Niski poziom zużycia paliwa i emisji spalin.',
  'Wygodne sterowanie — zegarem, pilotem lub telefonem komórkowym.',
];
---

<BaseLayout
  title="Ogrzewanie postojowe Webasto, Eberspächer, DEFA Wrocław — Klima-Kar"
  description="Autoryzowany serwis ogrzewań postojowych Webasto, Eberspächer i DEFA we Wrocławiu. Montaż, naprawa, diagnostyka i serwis ogrzewaczy niezależnych."
>
  <PageHero
    crumbs={[{ label: 'Strona główna', href: '/' }, { label: 'Ogrzewanie postojowe' }]}
    eyebrow="Usługi"
    title="Ogrzewanie postojowe Webasto, Eberspächer, DEFA"
    lead="Jesteśmy autoryzowanym serwisem trzech wiodących marek ogrzewaczy niezależnych. Wykonujemy montaże, naprawy gwarancyjne i pogwarancyjne."
    image="/images/galeria/war.JPG"
    imageAlt="Warsztat Klima-Kar — serwis ogrzewań postojowych"
    tag="Webasto · Eberspächer · DEFA"
    actions={[{ label: 'Umów wizytę', href: '/kontakt/' }, { label: 'Zobacz cennik', href: '/cennik/' }]}
  />

  <PhotoPanel season="winter" eyebrow="Webasto · Eberspächer · DEFA" title="Ogrzewanie postojowe">
    <div class="kk-g3">
      {brands.map((b) => <PartnerCard {...b} />)}
    </div>
    <div class="kk-photopanel-cta">
      <p class="kk-frost kk-ardic"><span class="kk-check"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg></span><span>Serwisujemy ponadto ogrzewania <strong>Ardic</strong>.</span></p>
    </div>
  </PhotoPanel>

  <section class="kk-wrap kk-section">
    <SectionHeader eyebrow="Wodne czy powietrzne?" title="Które ogrzewanie dla Ciebie" />
    <div class="kk-g2" style="gap:var(--svc-gap)">
      {types.map((t, i) => (
        <div class="kk-frost kk-card kk-type">
          <span class="kk-ico">{i === 0 ? <Car {...icon} /> : <Truck {...icon} />}</span>
          <span class="kk-partner-kind">{t.kind}</span>
          <h3 class="kk-card-title">{t.title}</h3>
          <span class="kk-chip kk-chip--tag" style="align-self:flex-start">{t.who}</span>
          <ul class="kk-checklist">
            {t.items.map((item) => <li><span class="kk-check" set:html={check} /><span>{item}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <FeatureList season="winter" eyebrow="Ogrzewanie postojowe" title="Zalety ogrzewania postojowego" items={benefits} />

  <ContentSection eyebrow="Ogrzewanie postojowe" title="Jak działa ogrzewanie wodne?">
    <p>Paliwowe, wodne ogrzewania postojowe (Webasto i Eberspächer) stosowane są w celu przygotowania samochodu do jazdy. Po włączeniu w ciągu kilkunastu do kilkudziesięciu minut nagrzeje się silnik, wnętrze pojazdu i rozmrożą się szyby.</p>
    <p>Ogrzewania wodne montowane są w obiegu płynu chłodzącego i stosowane są <strong>głównie w samochodach osobowych</strong>. Aktywuje się je w zależności od wybranego sterowania — pilotem, telefonem komórkowym lub nastawiając w zegarze godzinę uruchomienia albo odjazdu.</p>
    <p>Ciepło uzyskuje się poprzez spalanie paliwa pobieranego ze zbiornika. Płyn chłodzący nabiera temperatury i za pomocą pompy obiegowej przetłaczany jest do silnika oraz do nagrzewnicy. Pracujący wentylator wtłacza przez kratki nawiewowe podgrzane powietrze do wnętrza pojazdu.</p>
    <Fragment slot="callout-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></Fragment>
    <Fragment slot="callout">Warto pamiętać o zasadzie „czas ogrzewania = czas jazdy", aby akumulator rozruchowy był zawsze doładowany.</Fragment>
  </ContentSection>

  <ContentSection eyebrow="Ogrzewanie postojowe" title="Jak działa ogrzewanie powietrzne?">
    <p>Paliwowe, powietrzne ogrzewania postojowe (Webasto i Eberspächer) montowane są niezależnie. Stosowane są <strong>głównie w samochodach dostawczych i pojazdach ciężarowych</strong> w celu utrzymywania nastawionej temperatury we wnętrzu pojazdu. Ciepło uzyskuje się poprzez spalanie paliwa pobieranego ze zbiornika.</p>
    <p>Agregat tego typu ogrzewa powietrze i tłoczy je za pomocą własnej dmuchawy. Konstrukcja urządzenia pozwala na ciągłą pracę. Świetnie nadaje się do spania w pojeździe.</p>
  </ContentSection>

  <ContentSection eyebrow="Ogrzewanie postojowe" title="Koszty eksploatacji">
    <p>W przypadku ogrzewania wodnego jeden trzydziestominutowy cykl ogrzewania samochodu osobowego w zimowy poranek zużywa około 0,2 litra paliwa*. Warto zwrócić uwagę na fakt, że koszt eksploatacji częściowo się zwraca, ponieważ oszczędzamy na paliwie, którego większą ilość potrzebowałby nienagrzany silnik.</p>
    <p>Przykładowe ogrzewanie powietrzne Airtronic D2 o mocy 2 kW pobiera w zależności od warunków od 0,1 do 0,28 litra paliwa na godzinę pracy*. Gdy temperatura nie spada, urządzenie przechodzi w tryb czuwania — zużycie może być jeszcze niższe.</p>
    <div class="kk-fineprint">*Wartości orientacyjne. Rzeczywiste zużycie paliwa zależy od modelu urządzenia, jego mocy i warunków pracy.</div>
  </ContentSection>

  <ContentSection eyebrow="Ogrzewanie postojowe" title="Koszty montażu">
    <p>Ze względu na różnice techniczne pomiędzy modelami do każdego pojazdu przewidziano inny zestaw montażowy. Cena różni się w zależności od modelu pojazdu, wybranej mocy agregatu, elementów sterujących i stopnia integracji z systemem wentylacji.</p>
    <p>Dostępnych rozwiązań jest bardzo wiele, ale możemy podać orientacyjny przedział od 6.500 zł w przypadku ogrzewań powietrznych do busów, do kilkunastu tysięcy zł w przypadku skomplikowanych instalacji w autach osobowych. Szczegółową wycenę udzielamy po podaniu danych pojazdu — dokładne ceny montażu znajdziesz w naszym <a href="/cennik/">cenniku</a>.</p>
    <p>Diagnostyka ogrzewania postojowego Webasto lub Eberspächer — <strong>250 zł brutto</strong>.</p>
  </ContentSection>

  <ContentSection eyebrow="Ogrzewanie postojowe" title="Rozbudowa dogrzewacza do ogrzewania postojowego">
    <p>Wiele aut fabrycznie wyposażono w dogrzewacze silnika diesla — użytkownicy często nie wiedzą, że ich samochód ma dodatkowe ogrzewanie spalinowe. Dogrzewacz uruchamia się w niskich temperaturach, aby przyspieszyć osiągnięcie temperatury roboczej silnika.</p>
    <p>Takie dogrzewacze można przerobić na pełnoprawne ogrzewanie postojowe. Koszt rozbudowy jest znacznie niższy niż montaż ogrzewania od zera. Zainteresowanych prosimy o <a href="/kontakt/">kontakt</a>.</p>
  </ContentSection>

  <CTABanner title="Zapytaj o montaż lub naprawę" subtitle="tel. 71 337 14 50 · kom. 605 594 506" />
</BaseLayout>

<style>
  .kk-ardic {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    border-radius: var(--radius-pill);
    padding: 10px 20px 10px 10px;
    background: var(--frost-card);
    font-weight: 500;
    color: var(--navy);
  }
  .kk-ardic strong {
    font-weight: 700;
  }
  .kk-type {
    border-radius: var(--radius-card);
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .kk-type .kk-card-title {
    margin: 0;
  }
  .kk-type .kk-checklist li {
    padding: 12px 0;
    font-size: 16px;
  }
</style>
