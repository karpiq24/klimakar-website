---
import '../styles/global.css';
import '../styles/szron.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const siteUrl = 'https://klima-kar.wroclaw.pl';
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : `${siteUrl}${Astro.url.pathname}`;
// The demo build (GitHub Pages, see .github/workflows/deploy.yml) sets PUBLIC_NOINDEX=true so the preview
// stays out of Google. The production build for OVH must be made without it.
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Klima-Kar" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Google Fonts: Onest (body) + Unbounded (display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700&family=Onest:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"AutoRepair","name":"Klima-Kar","description":"Profesjonalny serwis klimatyzacji samochodowej oraz ogrzewań postojowych Webasto, Eberspächer i DEFA we Wrocławiu.","url":"https://klima-kar.wroclaw.pl","telephone":["+48713371450","+48605594506"],"email":"serwis@klima-kar.pl","address":{"@type":"PostalAddress","streetAddress":"ul. Grota Roweckiego 129","addressLocality":"Wrocław","postalCode":"52-214","addressCountry":"PL"},"geo":{"@type":"GeoCoordinates","latitude":51.05556,"longitude":17.03197},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"17:00"},"image":"https://klima-kar.wroclaw.pl/images/logo.svg","priceRange":"$$","areaServed":{"@type":"City","name":"Wrocław"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Usługi","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Klimatyzacja samochodowa"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Ogrzewanie postojowe Webasto"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Ogrzewanie postojowe Eberspächer"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Ogrzewanie postojowe DEFA"}}]}})} />

  </head>
  <body>
    <div class="kk-root kk-dots">
      <div aria-hidden="true" class="kk-glow kk-drift" style="right:-160px;top:-120px;width:760px;height:640px;background:var(--brand-ice);opacity:.35"></div>
      <div aria-hidden="true" class="kk-glow kk-drift2" style="left:-220px;top:380px;width:620px;height:520px;background:var(--brand);opacity:.18"></div>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
      <MobileCallBar />
    </div>
  </body>
</html>
