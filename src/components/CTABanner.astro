---
// CTABanner (variant B) — low frosted strip on a blue backlight, the last section before the footer.
// Under the subtitle: the live opening status (OpenStatus).
import OpenStatus from './OpenStatus.astro';

interface Props {
  title: string;
  subtitle: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, subtitle, actionLabel = 'Umów wizytę', actionHref = '/kontakt/' } = Astro.props;
---

<section class="kk-wrap kk-cta-wrap kk-section">
  <div aria-hidden="true" class="kk-glow" style="left:10%;top:40px;width:520px;max-width:80%;height:200px;background:var(--brand);opacity:.35;filter:blur(70px)"></div>
  <div aria-hidden="true" class="kk-glow" style="right:6%;top:80px;width:420px;max-width:70%;height:180px;background:var(--brand-ice);opacity:.35;filter:blur(70px)"></div>
  <div class="kk-frost kk-cta">
    <span class="kk-blue kk-cta-icon"><img src="/images/brand/flake-white.svg" alt="" aria-hidden="true" class="kk-spin-fast" style="width:32px;height:32px"></span>
    <div class="kk-cta-text"><h2 class="kk-cta-title" style="margin:0">{title}</h2><div class="kk-cta-sub">{subtitle}</div><OpenStatus /></div>
    <a href="tel:+48713371450" class="kk-cta-tel"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>71 337 14 50</a>
    <a href={actionHref} class="kk-btn kk-btn--primary kk-btn--lg">{actionLabel}</a>
  </div>
</section>
