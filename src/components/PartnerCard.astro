---
// PartnerCard — denser frost card per heater brand: logo, category line, description, three tags.
interface Props {
  brand: 'webasto' | 'eberspacher' | 'defa';
  kind: string;
  text: string;
  tags: string[];
  href?: string;
}

const LOGOS = {
  webasto: { alt: 'Webasto', cls: 'kk-lw' },
  eberspacher: { alt: 'Eberspächer', cls: 'kk-le' },
  defa: { alt: 'DEFA', cls: 'kk-ld' },
};

const { brand, kind, text, tags, href } = Astro.props;
const logo = LOGOS[brand];
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class="kk-frost kk-card kk-partner">
  <span class="kk-partner-logo"><img src={`/images/brand/${brand}.svg`} alt={logo.alt} class={logo.cls}></span>
  <span class="kk-partner-kind">{kind}</span>
  <p>{text}</p>
  <span class="kk-chips">{tags.map((t) => <span class="kk-chip kk-chip--tag">{t}</span>)}</span>
</Tag>
