---
// ProcessSteps — "Jak pracujemy": four numbered frost cards, from car intake to repair.
// The decision step is the grid's one solid brand card: we call before any repair.
// The heading and an optional link ("aside" slot) come from SectionHeader.
import SectionHeader from './SectionHeader.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = 'Jak pracujemy',
  title = 'Najpierw diagnoza, potem Twoja decyzja',
  description = 'Nie naprawiamy niczego bez Twojej zgody. Zanim zaczniemy, dzwonimy i mówimy, co trzeba zrobić i ile to będzie kosztować.',
} = Astro.props;

const steps = [
  {
    title: 'Przyjęcie auta',
    text: 'Umawiasz wizytę telefonicznie lub przez formularz i przyjeżdżasz do warsztatu przy ul. Grota Roweckiego 129. Powiedz nam, co się dzieje z klimatyzacją lub ogrzewaniem.',
  },
  {
    title: 'Diagnostyka i wycena',
    text: 'Sprawdzamy układ i ustalamy przyczynę usterki. Na tej podstawie przygotowujemy wycenę: zakres prac, potrzebne części i koszt.',
  },
  {
    title: 'Telefon i Twoja decyzja',
    text: 'Dzwonimy do Ciebie i mówimy, co i za ile. Naprawę zaczynamy dopiero wtedy, gdy ją zaakceptujesz.',
    brand: true,
  },
  {
    title: 'Naprawa',
    text: 'Uszkodzone części wymieniamy na nowe, a regenerujemy tylko wtedy, gdy nowej części nie da się zastosować. Na naprawy udzielamy gwarancji.',
  },
];
---

<section class="kk-wrap kk-section">
  <SectionHeader eyebrow={eyebrow} title={title} description={description} />
  <ol class="kk-steps">
    {steps.map((s, i) => (
      <li class:list={['kk-card kk-step', s.brand ? 'kk-blue' : 'kk-frost']}>
        <span class:list={['kk-step-n', !s.brand && 'kk-grad']}>{String(i + 1).padStart(2, '0')}</span>
        <h3 class="kk-card-title">{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
  {Astro.slots.has('default') && <div class="kk-steps-more"><slot /></div>}
</section>

<style>
  .kk-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--svc-gap);
  }
  .kk-step {
    border-radius: var(--radius-card);
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .kk-step .kk-card-title {
    margin: 0;
  }
  .kk-step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 15px;
  }
  .kk-step-n {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 3.4cqi, 48px);
    line-height: 1;
    letter-spacing: -0.04em;
    align-self: flex-start;
  }
  .kk-step.kk-blue .kk-card-title,
  .kk-step.kk-blue .kk-step-n {
    color: var(--white);
  }
  .kk-step.kk-blue p {
    color: var(--on-brand-muted);
  }
  .kk-steps-more {
    margin-top: 28px;
    text-align: center;
  }
  @container kk (max-width: 1100px) {
    .kk-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container kk (max-width: 600px) {
    .kk-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
