---
// ServiceCard — one service in the kk-svc grid. Variants:
//   standard  — frost card (most services)
//   brand     — solid brand card with the tilted white K mark (one "available now" offer per grid)
//   spotlight — navy gradient, two columns wide, outlined CO₂ and fact tags (the differentiator)
//   image     — frost card led by a real workshop photo
// The icon (Lucide, stroke 1.8) goes in the default slot. `chip` shows a status or price next to it.
interface Props {
  variant?: 'standard' | 'brand' | 'spotlight' | 'image';
  title: string;
  text: string;
  href?: string;
  chip?: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}

const { variant = 'standard', title, text, href, chip, tags = [], image, imageAlt = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const icoVariant = variant === 'brand' ? 'kk-ico--on-brand' : variant === 'spotlight' ? 'kk-ico--on-navy' : undefined;
const chipClass = variant === 'brand' ? 'kk-chip--on-brand' : variant === 'spotlight' ? 'kk-chip--ice' : undefined;
const live = variant === 'brand' || variant === 'spotlight';
const classes = {
  standard: 'kk-frost kk-card kk-svc-card',
  brand: 'kk-card kk-blue kk-svc-card kk-svc-card--brand',
  spotlight: 'kk-card kk-svc-card kk-svc-card--spotlight kk-svc-wide',
  image: 'kk-frost kk-card kk-svc-card kk-svc-card--image',
}[variant];
---

{variant === 'image' ? (
  <Tag href={href} class={classes}>
    <img src={image} alt={imageAlt}>
    <span>
      <span class="kk-ico"><slot /></span>
      <span class="kk-card-title">{title}</span>
      <span class="kk-svc-text">{text}</span>
    </span>
  </Tag>
) : (
  <Tag href={href} class={classes}>
    {variant === 'brand' && <img src="/images/brand/mark-white.svg" alt="" aria-hidden="true" class="kk-svc-mark">}
    {variant === 'spotlight' && <><span aria-hidden="true" class="kk-spot-glow"></span><span aria-hidden="true" class="kk-spot-co2">CO<sub>2</sub></span></>}
    {chip ? (
      <span class="kk-svc-top">
        <span class:list={['kk-ico', icoVariant]}><slot /></span>
        <span class:list={['kk-chip', chipClass]}>{live && <span class="kk-dot"></span>}{chip}</span>
      </span>
    ) : (
      <span class:list={['kk-ico', icoVariant]}><slot /></span>
    )}
    {variant === 'spotlight' && <span style="flex:1"></span>}
    <span class={variant === 'spotlight' ? 'kk-spot-title' : 'kk-card-title'} style={variant === 'brand' ? 'position:relative' : undefined}>{title}</span>
    <span class="kk-svc-text" style={variant === 'brand' ? 'position:relative' : undefined}>{text}</span>
    {tags.length > 0 && <span class="kk-tags">{tags.map((t) => <span class="kk-chip kk-chip--outline">{t}</span>)}</span>}
  </Tag>
)}
