---
/**
 * WHY: in-app browsers (Facebook, Instagram: Android WebView) scale all text by the phone's font-size
 * setting and CSS text-size-adjust can't turn that off, so cqi-sized headings like "Klimatyzacja" overflow there.
 */
---

<script>
  const SELECTOR = 'h1, h2, h3, .kk-price-big, .kk-stat-n';

  function fit() {
    for (const el of document.querySelectorAll<HTMLElement>(SELECTOR)) {
      el.style.fontSize = '';
      if (!el.clientWidth || el.scrollWidth <= el.clientWidth + 1) continue;
      // WHY: divide the size we set, not the computed one: under text zoom the computed size may
      // or may not include the zoom, so a second pass corrects the first if needed.
      let size = parseFloat(getComputedStyle(el).fontSize);
      for (let i = 0; i < 3 && el.scrollWidth > el.clientWidth + 1; i++) {
        size = (size * el.clientWidth) / el.scrollWidth - 0.5;
        el.style.fontSize = `${size}px`;
      }
    }
  }

  let lastViewportWidth = window.innerWidth;
  let timer: number | undefined;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastViewportWidth) return;
    lastViewportWidth = window.innerWidth;
    clearTimeout(timer);
    timer = window.setTimeout(fit, 150);
  });
  fit();
  document.fonts?.ready.then(fit);
</script>
