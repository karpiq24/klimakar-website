---
// Footer — frost card: brand blurb with small partner logos, three link columns and a bottom bar.
// The bottom bar links Klima-Kar's brand sites (src/data/strony.ts; they link back the same way).
import { strony } from '../data/strony';
---

<footer class="kk-wrap kk-footer">
  <div class="kk-frost">
    <div class="kk-foot">
      <div>
        <img src="/images/brand/logo-color.svg" alt="Klima-Kar" style="height:46px;width:auto;display:block">
        <p style="margin:16px 0;max-width:300px">Firma rodzinna z dwupokoleniową tradycją w branży chłodnictwa. Wrocław — w chłodnictwie od 1989 roku, jako Klima-Kar od 1999.</p>
        <div class="kk-foot-logos">
          <a href="/webasto/" style="line-height:0"><img src="/images/brand/webasto.svg" alt="Webasto" class="kk-lw"></a>
          <a href="/eberspacher/" style="line-height:0"><img src="/images/brand/eberspacher.svg" alt="Eberspächer" class="kk-le"></a>
          <a href="/defa/" style="line-height:0"><img src="/images/brand/defa.svg" alt="DEFA" class="kk-ld"></a>
        </div>
      </div>
      <div>
        <div class="kk-foot-h">Usługi</div>
        <div class="kk-foot-list">
          <a href="/klimatyzacja/">Klimatyzacja</a>
          <a href="/ogrzewanie-postojowe/">Ogrzewanie postojowe</a>
          <a href="/konserwacja/">Konserwacja</a>
          <a href="/dezynfekcja/">Dezynfekcja klimatyzacji</a>
          <a href="/tunap/">Dezynfekcja TUNAP</a>
          <a href="/dezynfekcja-bg/">Dezynfekcja BG</a>
          <a href="/cennik/">Cennik</a>
        </div>
      </div>
      <div>
        <div class="kk-foot-h">Informacje</div>
        <div class="kk-foot-list">
          <a href="/o-firmie/">O firmie</a>
          <a href="/jak-pracujemy/">Jak pracujemy</a>
          <a href="/gwarancja/">Gwarancja</a>
          <a href="/galeria/">Galeria</a>
          <a href="/rodo/">RODO</a>
          <button type="button" class="kk-foot-btn" data-consent-open>Ustawienia cookies</button>
        </div>
      </div>
      <div>
        <div class="kk-foot-h">Kontakt</div>
        <div class="kk-foot-list">
          <span>ul. Grota Roweckiego 129, 52-214 Wrocław</span>
          <a href="tel:+48713371450">71 337 14 50</a>
          <a href="tel:+48605594506">605 594 506</a>
          <a href="mailto:serwis@klima-kar.pl">serwis@klima-kar.pl</a>
          <span>Pon–Pt: 9:00–17:00, Sob–Nd: nieczynne</span>
        </div>
      </div>
    </div>
    <div class="kk-foot-bottom">
      <span>© Klima-Kar. Wszelkie prawa zastrzeżone.</span>
      <span>Nasze serwisy: {strony.filter((s) => s.key !== 'main').map((s, i) => <>{i > 0 && ' · '}<a href={s.url}>{s.label}</a></>)}</span>
      <span><a href="https://www.instagram.com/__klimakar__/" target="_blank" rel="noopener noreferrer">Instagram</a> · <a href="https://www.facebook.com/KlimaKar/" target="_blank" rel="noopener noreferrer">Facebook</a></span>
    </div>
  </div>
</footer>
