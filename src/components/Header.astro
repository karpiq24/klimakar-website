---
// Header — floating frosted pill, sticky at the top, with a highlight that slides between links
// (src/scripts/header.ts). Below 760px: a burger (the phone is in the bottom call bar) opening the frosted mobile menu.
const navLinks = [
  { label: 'Strona główna', href: '/', match: ['/'] },
  { label: 'Klimatyzacja', href: '/klimatyzacja/', match: ['/klimatyzacja/', '/konserwacja/', '/dezynfekcja/', '/tunap/', '/dezynfekcja-bg/'] },
  { label: 'Ogrzewanie', href: '/ogrzewanie-postojowe/', match: ['/ogrzewanie-postojowe/', '/webasto/', '/eberspacher/', '/defa/'] },
  { label: 'O firmie', href: '/o-firmie/', match: ['/o-firmie/'] },
  { label: 'Cennik', href: '/cennik/', match: ['/cennik/'] },
  { label: 'Kontakt', href: '/kontakt/', match: ['/kontakt/'] },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = (link: (typeof navLinks)[number]) => (link.match.includes(path) ? 'page' : undefined);
---

<div class="kk-wrap kk-headbar" id="kk-headbar">
  <header class="kk-header kk-frost">
    <a href="/" class="kk-header-logo" aria-label="Klima-Kar — strona główna"><img src="/images/brand/logo-color.svg" alt="Klima-Kar" width="125" height="30"></a>
    <nav class="kk-nav" aria-label="Główna">
      {navLinks.map((link) => <a href={link.href} aria-current={current(link)}>{link.label}</a>)}
    </nav>
    <a href="/kontakt/" class="kk-btn kk-btn--primary kk-btn--sm">Umów wizytę</a>
    <div class="kk-burger">
      <button type="button" class="kk-round kk-blue" aria-label="Menu" aria-expanded="false" aria-controls="kk-mnav" id="kk-burger"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg></button>
    </div>
  </header>
  <nav class="kk-mnav kk-frost" aria-label="Menu mobilne" id="kk-mnav" hidden>
    {navLinks.map((link) => <a href={link.href} aria-current={current(link)}>{link.label}</a>)}
    <a href="/kontakt/" class="kk-btn kk-btn--primary">Umów wizytę</a>
  </nav>
</div>

<script>
  import { initHeader } from '../scripts/header';

  initHeader(document.getElementById('kk-headbar'));

  const burger = document.getElementById('kk-burger');
  const menu = document.getElementById('kk-mnav');
  burger?.addEventListener('click', () => {
    if (!menu) return;
    const open = menu.hidden;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
