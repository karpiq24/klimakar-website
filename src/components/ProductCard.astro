---
// ProductCard (variant A) — packshot on white, type tag, name and the full feature checklist.
// Place cards inside <div class="kk-products">. `description` replaces the list (DEFA modules).
// A feature may contain `{dzisiaj}`, rendered as today's date ("cena na dzień {dzisiaj}").
// `retired` greys the card out and adds a "Produkt wycofany" chip (no longer sold; list it last).
import Today from './Today.astro';

interface Props {
  name: string;
  type?: string;
  image: string;
  imageAlt: string;
  features?: string[];
  description?: string;
  retired?: boolean;
}

const { name, type, image, imageAlt, features = [], description, retired = false } = Astro.props;
---

<div class:list={['kk-frost kk-card kk-product', { 'kk-product--retired': retired }]}>
  <span class="kk-product-shot"><img src={image} alt={imageAlt} loading="lazy"></span>
  <span class="kk-product-body">
    {(type || retired) && (
      <span class="kk-product-chips">
        {type && <span class="kk-chip kk-chip--tag">{type}</span>}
        {retired && <span class="kk-chip">Produkt wycofany</span>}
      </span>
    )}
    <h3 class="kk-product-name" style="margin:0">{name}</h3>
    {description && <p class="kk-svc-text">{description}</p>}
    {features.length > 0 && (
      <ul class="kk-product-feats">
        {features.map((f) => (
          <li><span class="kk-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{f.includes('{dzisiaj}') ? <>{f.split('{dzisiaj}')[0]}<Today />{f.split('{dzisiaj}')[1]}</> : f}</span></li>
        ))}
      </ul>
    )}
  </span>
</div>

<style>
  .kk-product-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .kk-product--retired {
    opacity: 0.62;
  }
  .kk-product--retired .kk-product-shot img {
    filter: grayscale(1);
  }
</style>
