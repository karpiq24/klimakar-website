---
// ContactForm — the enquiry form on the 0.92 frost-form surface. Posts JSON to /contact.php;
// field names (name, email, phone, contact, car, vin, message, website honeypot) match public/contact.php.
// Phone is optional unless the customer prefers a phone call.
---

<form id="contact-form" class="kk-form" novalidate>
  <h3 class="kk-h3">Wyślij zapytanie</h3>
  <p class="kk-muted" style="margin:0 0 8px">Wypełnij formularz, a odpowiemy na Twoje zapytanie.</p>
  <div class="kk-g2" style="gap:14px">
    <label class="kk-field">Imię i nazwisko *<input id="cf-name" name="name" class="kk-input" type="text" placeholder="Jan Kowalski" required autocomplete="name"><span class="kk-field-error" hidden>Pole wymagane</span></label>
    <label class="kk-field">Adres e-mail *<input id="cf-email" name="email" class="kk-input" type="email" placeholder="np. jan@example.com" required autocomplete="email"><span class="kk-field-error" hidden>Pole wymagane</span></label>
  </div>
  <div class="kk-g2" style="gap:14px">
    <label class="kk-field"><span>Telefon <span id="cf-phone-mark">(opcjonalnie)</span></span><input id="cf-phone" name="phone" class="kk-input" type="tel" placeholder="np. 600 100 200" autocomplete="tel"><span class="kk-field-error" hidden>Podaj numer, jeśli wolisz kontakt telefoniczny</span></label>
    <fieldset class="kk-field kk-choice">
      <legend>Preferowana forma kontaktu</legend>
      <div class="kk-choice-row">
        <label><input type="radio" name="contact" value="email" checked><span>E-mail</span></label>
        <label><input type="radio" name="contact" value="telefon"><span>Telefon</span></label>
      </div>
    </fieldset>
  </div>
  <div class="kk-g2" style="gap:14px">
    <label class="kk-field">Marka i model pojazdu, rocznik<input id="cf-car" name="car" class="kk-input" type="text" placeholder="np. Volkswagen Golf 2020"></label>
    <label class="kk-field">Numer VIN (opcjonalnie)<input id="cf-vin" name="vin" class="kk-input" type="text" placeholder="np. WVWZZZ1KZ6W000000" maxlength="17" autocapitalize="characters" spellcheck="false" autocomplete="off"></label>
  </div>
  <label class="kk-field">Dodatkowe informacje<textarea id="cf-message" name="message" class="kk-input" rows="4" placeholder="Opisz problem lub dodaj informacje..."></textarea></label>
  <div style="display:none" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
  <button type="submit" class="kk-btn kk-btn--primary kk-btn--lg">Wyślij zapytanie</button>
  <div id="contact-toast" class="kk-toast" role="status" aria-live="polite" hidden></div>
  <p class="kk-fineprint">Prosimy o podanie marki, modelu i rocznika pojazdu — ułatwi to wycenę usługi. Numer VIN pomoże nam dobrać właściwe części. W przypadku zapytania o montaż ogrzewania postojowego prosimy podać również rodzaj, pojemność i moc silnika oraz typ klimatyzacji (manualna / automatyczna).</p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const toast = document.getElementById('contact-toast') as HTMLDivElement;

  // The result stays under the submit button (a fixed corner toast hid behind the floating header).
  function showToast(message: string, success: boolean) {
    toast.textContent = message;
    toast.dataset.state = success ? 'ok' : 'error';
    toast.hidden = false;
    toast.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  const phone = form.querySelector<HTMLInputElement>('#cf-phone')!;
  const phoneMark = form.querySelector<HTMLElement>('#cf-phone-mark')!;
  const contactChoice = () => form.querySelector<HTMLInputElement>('input[name="contact"]:checked')?.value ?? 'email';

  // Preferring a phone call makes the phone number required.
  function syncPhoneRequired() {
    phone.required = contactChoice() === 'telefon';
    phoneMark.textContent = phone.required ? '*' : '(opcjonalnie)';
    if (!phone.required) validateField(phone);
  }
  form.querySelectorAll<HTMLInputElement>('input[name="contact"]').forEach((radio) => radio.addEventListener('change', syncPhoneRequired));

  function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
    const error = field.parentElement?.querySelector<HTMLElement>('.kk-field-error');
    const invalid = field.required && !field.value.trim();
    field.toggleAttribute('aria-invalid', invalid);
    if (error) error.hidden = !invalid;
    return !invalid;
  }

  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.kk-input')];

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    toast.hidden = true;

    let isValid = true;
    fields.forEach((field) => {
      if (!validateField(field)) isValid = false;
    });
    if (!isValid) return;

    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (honeypot && honeypot.value) {
      showToast('Dziękujemy! Skontaktujemy się wkrótce.', true);
      form.reset();
      return;
    }

    const value = (id: string) => (form.querySelector<HTMLInputElement | HTMLTextAreaElement>(id)?.value ?? '').trim();
    const data = {
      name: value('#cf-name'),
      email: value('#cf-email'),
      phone: value('#cf-phone'),
      contact: contactChoice(),
      car: value('#cf-car'),
      vin: value('#cf-vin').toUpperCase(),
      message: value('#cf-message'),
      website: honeypot?.value ?? '',
    };

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Wysyłanie...';

    try {
      const response = await fetch('/contact.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();

      if (result.success) {
        // Conversion for GTM (Google Ads, GA4); only after contact.php confirms the e-mail went out.
        (window as typeof window & { dataLayer?: unknown[] }).dataLayer?.push({ event: 'form_submit_success', form_id: 'kontakt' });
        showToast(result.message || 'Dziękujemy! Skontaktujemy się wkrótce.', true);
        form.reset();
        syncPhoneRequired();
        fields.forEach((field) => field.removeAttribute('aria-invalid'));
        form.querySelectorAll<HTMLElement>('.kk-field-error').forEach((el) => (el.hidden = true));
      } else {
        showToast(result.message || 'Wystąpił błąd. Proszę spróbować ponownie.', false);
      }
    } catch {
      showToast('Wystąpił błąd połączenia. Proszę napisać: serwis@klima-kar.pl', false);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Wyślij zapytanie';
    }
  });

  fields.forEach((field) => field.addEventListener('input', () => validateField(field)));
</script>

<style>
  .kk-input[aria-invalid] {
    border-color: var(--brand);
    box-shadow: var(--shadow-field-focus);
  }
  #cf-vin {
    text-transform: uppercase;
  }
  #cf-vin::placeholder {
    text-transform: none;
  }
  .kk-choice {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .kk-choice legend {
    padding: 0;
    margin-bottom: 6px;
  }
  .kk-choice-row {
    display: flex;
    gap: 8px;
  }
  .kk-choice-row label {
    flex: 1;
    position: relative;
  }
  .kk-choice-row input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .kk-choice-row span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 48px;
    border-radius: var(--radius-icon);
    border: 1px solid var(--brand-field-line);
    background: var(--field);
    font-weight: 600;
    color: var(--text-muted);
  }
  .kk-choice-row input:checked + span {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--white);
  }
  .kk-choice-row input:focus-visible + span {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }
  .kk-field-error {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand);
  }
  .kk-toast {
    border-radius: var(--radius-card-sm);
    padding: 16px 20px;
    background: var(--frost-form);
    font-weight: 600;
    color: var(--navy);
    box-shadow: var(--shadow-form);
  }
  .kk-toast[data-state='ok'] {
    background: var(--brand-tint);
    color: var(--brand);
  }
  [disabled] {
    opacity: 0.7;
    cursor: progress;
  }
</style>
