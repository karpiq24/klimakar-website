---
// ContentSection (variant A) — long text on one frost panel: sticky eyebrow + h2 on the left,
// paragraphs on the right, and an optional callout (slot "callout") for one sentence the page contains.
// An optional IconTile (slot "icon") can lead the heading column.
// Lists inside use <ul class="kk-checklist">.
interface Props {
  eyebrow: string;
  title: string;
  as?: 'h2' | 'h3';
  /** Anchor for links to this section (e.g. /rodo/#cookies). */
  id?: string;
}

const { eyebrow, title, as: Heading = 'h2', id } = Astro.props;
const hasCallout = Astro.slots.has('callout');
const hasIcon = Astro.slots.has('icon');
---

<section class="kk-wrap kk-section" id={id}>
  <div class="kk-frost kk-article">
    <div class="kk-article-side">{hasIcon && <span class="kk-ico" style="margin-bottom:20px"><slot name="icon" /></span>}<p class="kk-eyebrow">{eyebrow}</p><Heading class="kk-h2">{title}</Heading></div>
    <div class="kk-article-body">
      <slot />
      {hasCallout && (
        <div class="kk-callout">
          <span class="kk-check"><slot name="callout-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg></slot></span>
          <span><slot name="callout" /></span>
        </div>
      )}
    </div>
  </div>
</section>

<style is:global>
  /* Media and sub-blocks inside a ContentSection body (slot content). */
  .kk-article-body > img,
  .kk-article-body .kk-article-photo {
    width: 100%;
    display: block;
    border-radius: var(--radius-photo);
    margin: 8px 0 22px;
  }
  .kk-article-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--grid-gap);
    margin: 8px 0 22px;
  }
  .kk-article-photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-photo);
  }
  .kk-article-body .kk-checklist {
    margin: 0 0 18px;
    max-width: 64ch;
  }
  .kk-article-body .kk-card-title {
    display: block;
    margin: 8px 0 10px;
  }
  .kk-article-body .kk-fineprint {
    margin: 0 0 18px;
  }
  .kk-article-body a {
    color: var(--brand);
    font-weight: 600;
  }
  .kk-article-body strong {
    color: var(--navy);
    font-weight: 600;
  }
  .kk-checklist .kk-check {
    font-size: 13px;
    font-weight: 600;
  }
</style>
