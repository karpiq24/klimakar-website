---
// PageHero (variant A) — opens every subpage: breadcrumbs, eyebrow, h1, lead and buttons,
// with a 5:4 photo in a frost frame, a spinning-snowflake disc and a floating fact tag.
// Without an image the text spans the full width (max 760px).
interface Crumb {
  label: string;
  href?: string;
}
interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'frost';
}
interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  tag?: string;
  actions?: Action[];
}

const {
  crumbs,
  eyebrow,
  title,
  lead,
  image,
  imageAlt = '',
  imagePosition,
  tag,
  actions = [{ label: 'Umów wizytę', href: '/kontakt/' }],
} = Astro.props;
---

<section class="kk-wrap">
  <nav class="kk-crumbs" aria-label="Okruszki" style="margin-top:28px">
    {crumbs.map((c, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </>
    ))}
  </nav>
  <div class="kk-pagehero" style={image ? undefined : 'grid-template-columns:minmax(0,1fr)'}>
    <div style={image ? undefined : 'max-width:760px'}>
      <p class="kk-eyebrow">{eyebrow}</p>
      <h1 class="kk-pagehero-title">{title}</h1>
      <p class="kk-lead">{lead}</p>
      {actions.length > 0 && (
        <div class="kk-actions">
          {actions.map((a, i) => (
            <a href={a.href} class:list={['kk-btn', `kk-btn--${a.variant ?? (i === 0 ? 'primary' : 'frost')}`, 'kk-btn--lg']}>{a.label}</a>
          ))}
        </div>
      )}
    </div>
    {image && (
      <div class="kk-pagehero-photo">
        <div class="kk-frost kk-frame"><div class="kk-frame-photo"><img src={image} alt={imageAlt} style={imagePosition ? `object-position:${imagePosition}` : undefined}></div></div>
        <span class="kk-blue kk-pagehero-disc"><img src="/images/brand/flake-white.svg" alt="" aria-hidden="true" class="kk-spin" style="width:34px;height:34px"></span>
        {tag && (
          <span class="kk-frost kk-pagehero-tag"><b class="kk-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></b>{tag}</span>
        )}
      </div>
    )}
  </div>
</section>
