---
// FAQ (variant A) — native <details> accordions in one frost panel; the first item is open.
import SectionHeader from './SectionHeader.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: { question: string; answer: string[] }[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="kk-wrap kk-section">
  <SectionHeader eyebrow={eyebrow} title={title} />
  <div class="kk-frost kk-faq">
    {items.map((item, i) => (
      <details open={i === 0}>
        <summary>{item.question}<span class="kk-round"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span></summary>
        {item.answer.map((p) => <p>{p}</p>)}
      </details>
    ))}
  </div>
</section>
