---
// MobileCallBar — below 760px a "Zadzwoń do serwisu" bar stays at the bottom of the screen.
// One tap starts a call. The page gets matching bottom padding so the footer isn't covered.
// While an element marked `data-callbar-hide` is on screen (the homepage hero buttons, the brand-site
// hero's "Zadzwoń" button), the bar slides away: the first screen stays clean and there aren't two
// blue call buttons at once. Near the contact card and CTABanner it stays (owner). Without JS it always shows.
---

<a href="tel:+48713371450" class="kk-callbar" id="kk-callbar" aria-label="Zadzwoń do serwisu: 71 337 14 50">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
  <span>Zadzwoń do serwisu</span>
  <span class="kk-callbar-num">71 337 14 50</span>
</a>

<style>
  .kk-callbar {
    display: none;
  }
  @container kk (max-width: 760px) {
    .kk-callbar {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 0 20px;
      border-radius: var(--radius-pill);
      background: var(--brand);
      color: var(--white);
      font-weight: 600;
      text-decoration: none;
      box-shadow: var(--shadow-callbar);
    }
    .kk-callbar-num {
      font-weight: 400;
      color: var(--on-brand-muted);
    }
    .kk-callbar.is-ready {
      transition: transform 0.3s ease, opacity 0.3s;
    }
    .kk-callbar.is-away {
      transform: translateY(calc(100% + 24px));
      opacity: 0;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kk-callbar.is-ready {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('kk-callbar');
  const twins = document.querySelectorAll('[data-callbar-hide]');
  if (bar && twins.length) {
    const seen = new Set<Element>();
    const onScreen = (t: Element) => {
      const r = t.getBoundingClientRect();
      return r.bottom > 0 && r.top < innerHeight;
    };
    bar.classList.toggle('is-away', [...twins].some(onScreen));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      bar.classList.toggle('is-away', seen.size > 0);
      // No slide on the first check, so the bar doesn't flash away on load.
      requestAnimationFrame(() => bar.classList.add('is-ready'));
    });
    twins.forEach((t) => observer.observe(t));
  }
</script>

<style is:global>
  @container kk (max-width: 760px) {
    .kk-root > .kk-footer {
      padding-bottom: calc(92px + env(safe-area-inset-bottom));
    }
  }
</style>
