---
// Seasons — SeasonModule (two linked halves joined by a snowflake knob) + MonthBanner.
// The month, its tip, CTA, bar segments, the tinted half and the "Teraz" chip are set on the
// client from MONTHS, so a static build never freezes the month. Build-time month is the fallback.
const MONTHS = [
  ['Styczeń', 'zima', 'Zimny start to obciążenie dla silnika — ogrzewanie postojowe nagrzeje go, zanim przekręcisz kluczyk.', 'Ogrzewanie postojowe', '/ogrzewanie-postojowe/'],
  ['Luty', 'zima', 'Ogrzewanie nie startuje albo dymi? Zdiagnozujemy i naprawimy Webasto i Eberspächer.', 'Umów naprawę ogrzewania', '/ogrzewanie-postojowe/'],
  ['Marzec', 'lato', 'Zima za nami — sprawdź klimatyzację, zanim przyjdą ciepłe dni.', 'Umów serwis klimatyzacji', '/klimatyzacja/'],
  ['Kwiecień', 'lato', 'Zrób serwis klimatyzacji przed pierwszym upałem.', 'Umów serwis klimatyzacji', '/klimatyzacja/'],
  ['Maj', 'lato', 'Nieprzyjemny zapach z nawiewów? Odgrzybimy klimatyzację metodą TUNAP lub ultradźwiękami.', 'Dezynfekcja klimatyzacji', '/dezynfekcja/'],
  ['Czerwiec', 'lato', 'Klimatyzacja słabo chłodzi? Sprawdzimy szczelność układu i napełnimy go czynnikiem.', 'Umów diagnostykę', '/klimatyzacja/'],
  ['Lipiec', 'lato', 'Upał w aucie? Przyjedź — sprawdzimy i naprawimy klimatyzację.', 'Umów wizytę', '/klimatyzacja/'],
  ['Sierpień', 'lato', 'Sprężarka hałasuje albo się nie załącza? Naprawimy lub wymienimy ją na nową.', 'Skuteczne naprawy', '/klimatyzacja/'],
  ['Wrzesień', 'zima', 'Lato się kończy — to dobry moment na montaż ogrzewania postojowego.', 'Webasto · Eberspächer · DEFA', '/ogrzewanie-postojowe/'],
  ['Październik', 'zima', 'Sprawdź ogrzewanie, zanim spadnie pierwszy śnieg.', 'Umów przegląd Webasto / Eberspächer', '/ogrzewanie-postojowe/'],
  ['Listopad', 'zima', 'Ciepłe auto bez skrobania szyb — montujemy Webasto, Eberspächer i DEFA.', 'Umów montaż', '/ogrzewanie-postojowe/'],
  ['Grudzień', 'zima', 'Szron na szybach? Z ogrzewaniem postojowym auto jest ciepłe, zanim do niego wsiądziesz.', 'Ogrzewanie postojowe', '/ogrzewanie-postojowe/'],
];

const i = new Date().getMonth();
const [name, season, text, cta, href] = MONTHS[i];
const winter = season === 'zima';
const sun = '<circle cx="24" cy="24" r="8"></circle><g class="kk-spin-fast" style="transform-origin:24px 24px"><path d="M24 4v6M24 38v6M4 24h6M38 24h6M9.9 9.9l4.2 4.2M33.9 33.9l4.2 4.2M9.9 38.1l4.2-4.2M33.9 14.1l4.2-4.2"></path></g>';
---

<section class="kk-wrap" aria-label="Lato i zima" style="position:relative;padding-top:clamp(64px,8cqi,110px)">
  <div class="kk-frost kk-seasons">
    <a href="/klimatyzacja/" class:list={['kk-half', { 'is-now': !winter }]} data-season="lato">
      <span class="kk-half-top">
        <span class="kk-ico"><svg viewBox="0 0 48 48" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" set:html={sun} /></span>
        <span class="kk-chip kk-chip--now" hidden={winter}><span class="kk-dot"></span>Teraz</span>
      </span>
      <span class="kk-eyebrow" style="margin:0">Lato · klimatyzacja</span>
      <span class="kk-sh">Latem chłodzimy.</span>
      <span class="kk-muted" style="max-width:440px">Serwis, naprawa i odgrzybianie klimatyzacji. Każdy czynnik — R12, R134a, R1234yf, R744.</span>
      <img class="kk-half-photo" src="/images/lato-1.webp" alt="Parking w upalny dzień — auto z działającą klimatyzacją">
    </a>
    <div class="kk-knob" aria-hidden="true"><span class="kk-blue"><img src="/images/brand/flake-white.svg" alt="" class="kk-spin-fast" style="width:22px;height:22px"></span></div>
    <a href="/ogrzewanie-postojowe/" class:list={['kk-half', { 'is-now': winter }]} data-season="zima">
      <span class="kk-half-top">
        <span class="kk-ico"><img src="/images/brand/flake-blue.svg" alt="" aria-hidden="true" class="kk-spin-fast" style="width:32px;height:32px"></span>
        <span class="kk-chip kk-chip--now" hidden={!winter}><span class="kk-dot"></span>Teraz</span>
      </span>
      <span class="kk-eyebrow" style="margin:0">Zima · ogrzewanie postojowe</span>
      <span class="kk-sh">Zimą grzejemy.</span>
      <span class="kk-muted" style="max-width:440px">Autoryzowany serwis Webasto i Eberspächer. Montaż DEFA. Ciepłe auto bez skrobania szyb.</span>
      <img class="kk-half-photo" src="/images/webastoauto.jpg" alt="Samochód z ogrzewaniem postojowym zimą">
    </a>
  </div>

  <div class="kk-frost kk-banner" id="kk-month" data-months={JSON.stringify(MONTHS)}>
    <span class="kk-blue kk-banner-icon">
      <img src="/images/brand/flake-white.svg" alt="" aria-hidden="true" class="kk-spin-fast" style="width:32px;height:32px" data-icon="zima" hidden={!winter}>
      <svg viewBox="0 0 48 48" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" data-icon="lato" hidden={winter} set:html={sun} />
    </span>
    <span>
      <span style="display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px"><span class="kk-banner-month" data-m="name">{name}</span><span class="kk-banner-msg" data-m="text">{text}</span></span>
      <span class="kk-banner-bar" aria-hidden="true">
        {MONTHS.map((_, k) => <span class:list={['kk-seg', { on: k === i, past: k < i }]}></span>)}
      </span>
    </span>
    <a href={href} class="kk-btn kk-btn--primary" data-m="cta">{cta} →</a>
  </div>
</section>

<script>
  const banner = document.getElementById('kk-month');
  if (banner) {
    const months: string[][] = JSON.parse(banner.dataset.months || '[]');
    const i = new Date().getMonth();
    const [name, season, text, cta, href] = months[i];
    const set = (key: string, value: string) => {
      const el = banner.querySelector<HTMLElement>(`[data-m="${key}"]`);
      if (el) el.textContent = value;
    };
    set('name', name);
    set('text', text);
    set('cta', `${cta} →`);
    banner.querySelector<HTMLAnchorElement>('[data-m="cta"]')?.setAttribute('href', href);
    banner.querySelectorAll<HTMLElement>('.kk-seg').forEach((seg, k) => {
      seg.classList.toggle('on', k === i);
      seg.classList.toggle('past', k < i);
    });
    banner.querySelectorAll<SVGElement | HTMLElement>('[data-icon]').forEach((icon) => {
      icon.toggleAttribute('hidden', icon.dataset.icon !== season);
    });
    document.querySelectorAll<HTMLElement>('.kk-half[data-season]').forEach((half) => {
      const now = half.dataset.season === season;
      half.classList.toggle('is-now', now);
      half.querySelector('.kk-chip--now')?.toggleAttribute('hidden', !now);
    });
  }
</script>
