---
// HeaterTypes — "Które ogrzewanie dla Ciebie" for one brand: the season-module halves (wodne | flame
// knob | powietrzne), each with its checklist and that brand's heater model (HeaterModels).
// Used on /webasto/, /eberspacher/ and the brand sites. `types` comes from heaterTypes() in
// src/data/ogrzewanie.ts; model images must already be URLs the build can serve.
import SectionHeader from './SectionHeader.astro';
import HeaterModels from './HeaterModels.astro';
import { Car, Flame, Truck } from 'lucide-astro';
import type { heaterTypes } from '../data/ogrzewanie';

interface Props {
  types: ReturnType<typeof heaterTypes>;
  id?: string;
}

const { types, id } = Astro.props;
const icon = { size: 24, 'stroke-width': 1.8, 'aria-hidden': 'true' };
const check = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';
---

<section class="kk-wrap kk-section" id={id}>
  <SectionHeader eyebrow="Wodne czy powietrzne?" title="Które ogrzewanie dla Ciebie" />
  <div class="kk-frost kk-seasons kk-heater-types">
    {types.map((t, i) => (
      <>
        {i === 1 && <div class="kk-knob" aria-hidden="true"><span class="kk-blue"><Flame size={20} stroke-width={2} aria-hidden="true" /></span></div>}
        <div class="kk-half">
          <span class="kk-ico">{i === 0 ? <Car {...icon} /> : <Truck {...icon} />}</span>
          <span class="kk-partner-kind">{t.kind}</span>
          <h3 class="kk-card-title" style="margin:0">{t.title}</h3>
          <span class="kk-chip kk-chip--tag">{t.who}</span>
          <ul class="kk-checklist">
            {t.items.map((item) => <li><span class="kk-check" set:html={check} /><span>{item}</span></li>)}
          </ul>
          <HeaterModels models={t.models} />
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .kk-heater-types .kk-half {
    gap: 12px;
  }
  .kk-heater-types .kk-half > .kk-chip--tag {
    align-self: flex-start;
    justify-self: start;
  }
  .kk-heater-types .kk-checklist li {
    padding: 12px 0;
    font-size: 16px;
  }
  /* Both halves share one row grid (icon, kind, title, who, list, models), so the model cards
     start on the same line and end together even when one checklist is longer. */
  @container kk (min-width: 761px) {
    .kk-heater-types {
      grid-template-rows: repeat(6, auto);
    }
    .kk-heater-types .kk-half {
      display: grid;
      grid-row: 1 / span 6;
      grid-template-rows: subgrid;
      row-gap: 12px;
      align-items: start;
    }
    .kk-heater-types .kk-knob {
      grid-row: 1 / -1;
    }
    .kk-heater-types .kk-half > :global(.kk-models) {
      align-self: stretch;
    }
  }
</style>
