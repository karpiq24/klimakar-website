# Brand sites (webasto.wroclaw.pl, eberspaecher.wroclaw.pl) — production (OVH, Apache).
# The same file serves both domains: every redirect keeps the requested host.

# index.php is deliberately not listed: the old site's index.php must not answer / (delete it anyway).
DirectoryIndex index.html

RewriteEngine On

# Old site: /index.php → /, old sitemap → new sitemap. Straight to the final https URL without
# www (one hop, absolute so it stays https); the trailing "?" drops the old query string.
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^index\.php$ https://%1/? [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^sitemap\.xml$ https://%1/sitemap-index.xml [R=301,L]

# https and no www (as the old sites did). OVH's documented https test is the port.
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
