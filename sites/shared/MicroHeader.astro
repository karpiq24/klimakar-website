---
// Brand-site header: the Header pill with Klima-Kar + partner logo and in-page links.
// A scroll spy marks the section on screen. Below 760px: a burger (the phone is in the bottom call bar), as on the main site.
import type { Brand } from './brand';
import { sections } from './brand';
import logoColor from '../../public/images/brand/logo-color.svg';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
const headerSections = sections.filter((s) => !s.footerOnly);
// Intrinsic sizes (SVG viewBox ratio at the desktop height) so the header doesn't shift on load.
const logoSize = { webasto: { width: 90, height: 19 }, eberspaecher: { width: 100, height: 29 } };
---

<div class="kk-wrap kk-headbar" id="kk-headbar">
  <header class="kk-header kk-frost">
    <a href="#top" class="kk-header-logo mk-logos" aria-label={`Klima-Kar — Autoryzowany Serwis ${brand.name}`}>
      <img src={logoColor.src} alt="Klima-Kar" width="125" height="30">
      <span class="mk-logos-sep" aria-hidden="true"></span>
      <img src={brand.logo} alt={brand.name} class:list={['mk-logos-partner', `mk-logos-partner--${brand.key}`]} {...logoSize[brand.key]}>
    </a>
    <nav class="kk-nav" aria-label="Sekcje strony">
      {headerSections.map((s) => <a href={`#${s.id}`} data-spy={s.id}>{s.label}</a>)}
    </nav>
    <a href="#kontakt" class="kk-btn kk-btn--primary kk-btn--sm">Umów wizytę</a>
    <div class="kk-burger">
      <button type="button" class="kk-round kk-blue" aria-label="Menu" aria-expanded="false" aria-controls="kk-mnav" id="kk-burger"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg></button>
    </div>
  </header>
  <nav class="kk-mnav kk-frost" aria-label="Menu mobilne" id="kk-mnav" hidden>
    {headerSections.map((s) => <a href={`#${s.id}`} data-spy={s.id}>{s.label}</a>)}
    <a href="#kontakt" class="kk-btn kk-btn--primary">Umów wizytę</a>
  </nav>
</div>

<script>
  import { initHeader } from '../../src/scripts/header';

  initHeader(document.getElementById('kk-headbar'));

  const burger = document.getElementById('kk-burger');
  const menu = document.getElementById('kk-mnav');
  const setMenu = (open: boolean) => {
    if (!menu || !burger) return;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
  };
  burger?.addEventListener('click', () => setMenu(!!menu?.hidden));
  // In-page links close the mobile menu.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Scroll spy: the link of the section crossing the upper third of the screen gets aria-current.
  // Past the last tracked section (Klima-Kar cards, footer) nothing is marked.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const targets = [...new Set(links.map((a) => a.dataset.spy!))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  const mark = (id: string | null) => links.forEach((a) => (a.dataset.spy === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  const spy = () => {
    const line = window.innerHeight / 3;
    let current: string | null = null;
    for (const el of targets) {
      const r = el.getBoundingClientRect();
      if (r.top <= line && r.bottom > line) current = el.id;
    }
    mark(current);
  };
  addEventListener('scroll', spy, { passive: true });
  addEventListener('resize', spy);
  spy();
</script>

<style>
  .mk-logos {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .mk-logos-partner {
    width: auto;
  }
  .mk-logos-sep {
    width: 1px;
    height: 28px;
    background: var(--brand-line);
  }
  /* Same 24:37 optical balance as the LogoStrip (Webasto is wide, Eberspächer has a tall mark). */
  .mk-logos .mk-logos-partner--webasto {
    height: 19px;
  }
  .mk-logos .mk-logos-partner--eberspaecher {
    height: 29px;
  }
  /* The nav styles aria-current="page"; the scroll spy sets "true" (the floating pill marks it). */
  .kk-nav a[aria-current='true'] {
    color: var(--brand);
  }
  .kk-mnav a[aria-current='true'] {
    background: var(--white);
    color: var(--brand);
  }
  @container kk (max-width: 760px) {
    .mk-logos {
      gap: 10px;
    }
    .mk-logos img:first-child {
      height: 26px;
    }
    .mk-logos .mk-logos-partner--webasto {
      height: 15px;
    }
    .mk-logos .mk-logos-partner--eberspaecher {
      height: 23px;
    }
  }
</style>
